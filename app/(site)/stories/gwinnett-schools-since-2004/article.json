"<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Were Gwinnett Schools Better in the 2000s? | GCPS Data</title><meta name=\"description\" content=\"Compare Gwinnett school results since 2004. See how the graduation gap narrowed across ten high schools and why district reading scores tell a different story.\"><meta property=\"og:type\" content=\"article\"><meta property=\"og:title\" content=\"Were Gwinnett schools better when you were a kid?\"><meta property=\"og:description\" content=\"Five Gwinnett high schools gained 13.5 points in graduation on average. Explore which schools caught up and what district averages hide.\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Were Gwinnett County Public Schools better in the 2000s?\",\"description\":\"Compare Gwinnett school results since 2004. See how the graduation gap narrowed across ten high schools and why district reading scores tell a different story.\",\"author\":{\"@type\":\"Person\",\"name\":\"Michael Yang\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"All Things Gwinnett\"},\"citation\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\",\"https://www.gpb.org/news/2010/10/19/gwinnett-schools-win-prestigious-prize\",\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\",\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\",\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\",\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gwinnett-sat-results-top-national-average\",\"https://resources.finalsite.net/images/v1759332983/fultonschoolsorg/oswe4noo5uojmnyqlssb/SATExecutiveSummary2025.pdf\",\"https://goews.georgia.gov/dashboards-data-report-card/downloadable-data\",\"https://goews.georgia.gov/dashboards-data-report-card/data-dashboards/hs-grad-outcomes\",\"https://www.gwinnettcounty.com/static/departments/planning/Census/census_2000_selected_income_and_poverty_status_characteristics.pdf\",\"https://www.gcpsk12.org/schools/clusters/list-of-schools-by-cluster\"],\"inLanguage\":\"en-US\",\"@id\":\"#article\",\"hasPart\":[{\"@id\":\"#data-enrollment\"},{\"@id\":\"#data-math\"},{\"@id\":\"#data-reading\"},{\"@id\":\"#data-historical-graduation\"},{\"@id\":\"#data-four-year-graduation\"},{\"@id\":\"#faq\"},{\"@id\":\"#data-graduation-gap\"}]},{\"@type\":\"Dataset\",\"@id\":\"#data-enrollment\",\"name\":\"How fast did GCPS grow?\",\"description\":\"How fast did GCPS grow?. District enrollment, fiscal years 2004–2010. Reported years: 2004, 2005, 2006, 2007, 2008, 2009, 2010.\",\"temporalCoverage\":\"2004/2010\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"District enrollment, fiscal years 2004–2010\",\"citation\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isBasedOn\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-math\",\"name\":\"Math achievement in grades 3–8\",\"description\":\"Math achievement in grades 3–8. Grade-level equivalents relative to the 2019 national average. Reported years: 2019, 2022, 2024.\",\"temporalCoverage\":\"2019/2024\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"Grade-level equivalents relative to the 2019 national average\",\"citation\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isBasedOn\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-reading\",\"name\":\"Reading achievement in grades 3–8\",\"description\":\"Reading achievement in grades 3–8. Grade-level equivalents relative to the 2019 national average. Reported years: 2019, 2022, 2024.\",\"temporalCoverage\":\"2019/2024\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"Grade-level equivalents relative to the 2019 national average\",\"citation\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isBasedOn\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-historical-graduation\",\"name\":\"Graduation under Georgia’s earlier calculation\",\"description\":\"Graduation under Georgia’s earlier calculation. District graduation rate (%). Reported years: 2004, 2005, 2006, 2007, 2008, 2009, 2010.\",\"temporalCoverage\":\"2004/2010\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"District graduation rate (%)\",\"citation\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isBasedOn\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-four-year-graduation\",\"name\":\"Four-year graduation under the cohort calculation\",\"description\":\"Four-year graduation under the cohort calculation. District graduation rate (%). Reported years: 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026.\",\"temporalCoverage\":\"2016/2026\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"District graduation rate (%)\",\"citation\":[\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\",\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\"],\"isBasedOn\":[\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\",\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"FAQPage\",\"@id\":\"#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Which Gwinnett high schools made the biggest gains as a group?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Among neighborhood high schools with graduation results in both 2016 and 2025, the five with the lowest 2016 rates rose from an average of 71.0% to 84.5%. The five highest starters rose from 93.2% to 93.7%.\"}},{\"@type\":\"Question\",\"name\":\"Did the highest-performing schools carry Gwinnett’s graduation rate?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The higher-starting schools sustained high graduation rates. The lower-starting group improved faster. Calculating each group’s contribution to the districtwide gain requires its adjusted cohort sizes as well as its graduation rates.\"}},{\"@type\":\"Question\",\"name\":\"Did reading improve in the same Gwinnett clusters?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The district-level reading estimates used here cover grades 3–8. They cannot establish which feeder schools drove the decline or whether those schools belong to the same clusters that gained in graduation.\"}},{\"@type\":\"Question\",\"name\":\"Does the data show higher-income families moving north within Gwinnett?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The historical census maps show where households lived. Establishing that families moved from southwest Gwinnett to northern Gwinnett also requires evidence of their origins and destinations.\"}},{\"@type\":\"Question\",\"name\":\"Does this include Buford City Schools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The school results cover Gwinnett County Public Schools. Buford City Schools is a separate district. The county census maps cover a broader population than the GCPS student body.\"}}]},{\"@type\":\"Dataset\",\"@id\":\"#data-graduation-gap\",\"name\":\"Gwinnett high school graduation rates by 2016 starting group\",\"description\":\"Annual unweighted means for two fixed groups of five neighborhood high schools with official district graduation rates.\",\"temporalCoverage\":\"2016/2025\",\"variableMeasured\":\"Four-year graduation rate (%)\",\"isBasedOn\":\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\",\"isPartOf\":{\"@id\":\"#article\"}}]}</script><style>*{box-sizing:border-box}body{margin:0;background:#faf9f5;color:#202d32;font:19px/1.65 Georgia,serif}header,main{max-width:790px;margin:auto;padding:0 21px}header{padding-top:22px;border-top:7px solid #1d5246}header b,nav,.src,figcaption,small,table,summary,label,button,.meta{font-family:Arial,sans-serif}.brand{color:#245749;letter-spacing:.04em}h1{font-size:clamp(39px,6vw,66px);line-height:1.02;letter-spacing:-.045em;margin:30px 0 15px}h2{margin:2em 0 .4em;font-size:clamp(28px,4vw,38px);line-height:1.13;letter-spacing:-.025em}.meta,small,.src{font-size:14px}.src{line-height:1.55;color:#394d48}.hero{display:block;width:100%;height:auto;border-radius:5px;margin:19px 0}a{color:#215f50;text-underline-offset:3px}nav{border-block:1px solid #abb6ae;padding:14px 0;font-size:15px}figure{margin:24px 0 8px;background:white;border:1px solid #c5cfc8;padding:clamp(10px,3vw,24px);border-radius:8px}figcaption{font-weight:700;line-height:1.3}.control{font:15px Arial;margin:13px 0}.scroll{overflow:auto}table{border-collapse:collapse;width:100%;font-size:14px;font-variant-numeric:tabular-nums}td,th{text-align:right;border-bottom:1px solid #ddd;padding:6px}th:first-child{text-align:left}caption{text-align:left;font-size:12px;margin-top:10px}summary,button,select{cursor:pointer}select,button{font:inherit;color:inherit}button{background:transparent;border:0;text-decoration:underline}summary{font-size:15px}svg{width:100%;height:auto}main{padding-bottom:65px} .refs{margin-left:.2em;font:11px Arial;vertical-align:super}.refs a{padding:2px;text-decoration:none}.refs a:hover,.refs a:focus{text-decoration:underline}.credit,#sources li{font:14px/1.55 Arial,sans-serif}.credit{border-top:1px solid #d9dfda;margin-top:14px;padding-top:9px}#sources li{margin:.6em 0;padding:.25em}#sources li:target{background:#fff0c5} .plot{position:relative}.point-tip{position:absolute;top:0;pointer-events:none;white-space:pre-line;background:#163e35;color:white;padding:6px 10px;border-radius:6px;font:13px/1.45 Arial,sans-serif;box-shadow:0 2px 8px #0003}.plot rect:focus-visible{outline:2px solid #17634f} .contents{margin:30px 0;padding:20px 24px;background:#eff3ed;border:1px solid #c3d1c7;border-radius:10px}.contents strong{font: bold 24px Georgia,serif}.contents ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;padding:0;margin:12px 0 0;list-style:none}.contents a{display:flex;align-items:center;justify-content:space-between;min-height:44px;gap:8px;border-top:1px solid #ccd7ce;text-decoration:none}.contents a:hover,.contents a:focus-visible{text-decoration:underline}.contents span{color:#497361}#faq details{border-bottom:1px solid #c4cfc7;padding:0 0 2px}#faq summary{padding:14px 0;font-weight:600;line-height:1.5}#faq p{margin:0 0 10px}#faq .refs{display:block;margin-bottom:12px}#faq summary:focus-visible,.contents a:focus-visible{outline:2px solid #215f50;outline-offset:2px}@media(max-width:560px){.contents{padding:16px}.contents ul{grid-template-columns:1fr}}</style><link rel=\"canonical\" href=\"https://allthingsgwinnett.com/stories/gwinnett-schools-since-2004\"><meta property=\"og:url\" content=\"https://allthingsgwinnett.com/stories/gwinnett-schools-since-2004\"><meta property=\"og:image\" content=\"https://allthingsgwinnett.com/images/gcps-schools-social.jpg\"><meta property=\"og:image:width\" content=\"1200\"><meta property=\"og:image:height\" content=\"630\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"keywords\" content=\"Gwinnett County Public Schools, GCPS, Gwinnett schools, Gwinnett school rankings, Gwinnett schools in the 2000s, school performance, graduation rate, SAT scores, reading scores, math scores, student achievement, Georgia school districts, Gwinnett school enrollment\"></head><body><header><b class=\"brand\"><a href=\"/\">All Things Gwinnett</a> / <a href=\"/local-life\">Local Life</a></b><h1>Were Gwinnett County Public Schools better in the 2000s?</h1><div class=\"meta\">Education · By Michael Yang, All Things Gwinnett · November 21, 2026</div><img class=\"hero\" width=\"1672\" height=\"941\" src=\"/images/gcps-school-bus.jpg\" alt=\"A yellow school bus rounds a curve outside a brick school building.\"></header><main><article><p>At Berkmar High School, 65 out of every 100 students in the Class of 2016 graduated in four years. By the Class of 2025, it was about 82. At North Gwinnett High School, the rate went from about 96 to 97. If you grew up near one school and your kids now attend the other, which one tells you whether Gwinnett schools have gotten better?<sup class=\"refs\"><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a></sup></p>\n<p><strong>The graduation gap narrowed substantially. Reading took a different turn.</strong> The five neighborhood high schools that started with the lowest graduation rates in 2016 gained 13.5 percentage points on average by 2025. The five highest starters gained 0.6 points. Meanwhile, across GCPS, reading achievement in grades 3–8 fell behind comparable Georgia districts between 2019 and 2024. Both findings matter to a parent. They describe different students, at different ages, doing different things.<sup class=\"refs\"><a href=\"#source-3\" aria-label=\"Source 3\">[3]</a><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a></sup></p>\n<p>I’m Michael Yang, a Gwinnett parent reading the public records. Education research isn’t my profession. What I wanted to know was whether the reputation people remember from the 2000s held up once you looked beyond one district average. I also wanted to know whose progress that average might hide.</p>\n<nav class=\"contents\" aria-label=\"In this article\"><strong>In this article</strong><ul><li><a href=\"#gap\">The graduation gap<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#history\">Gwinnett in the 2000s<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#achievement\">Reading and math<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#households\">Income and migration<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#grad\">Graduation and SAT scores<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#verdict\">What I take from this<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#faq\">Frequently asked questions<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#methods\">Methods and sources<span aria-hidden=\"true\">↓</span></a></li></ul></nav>\n<h2 id=\"gap\">Which Gwinnett high schools closed the graduation gap?</h2>\n<p>I started with a decade of school-by-school results. In 2016, North Gwinnett, Brookwood, Grayson, Parkview and Mill Creek had the five highest graduation rates among the neighborhood high schools in my comparison. At the other end were Berkmar, Shiloh, Discovery, Norcross and Meadowcreek. I kept those groups together all the way through 2025. If a school improved, I wanted its progress to count in the group where it started.<sup class=\"refs\"><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a></sup></p>\n<figure class=\"ex\" id=\"data-graduation-gap\"><figcaption>Did the same Gwinnett high schools grow closer?</figcaption><small>Four-year graduation rate (%). Groups fixed by 2016 rate. Each school counts equally within its group.</small><div class=\"control\"></div><div class=\"plot\"></div><details open><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Graduation rates by starting group and class year (%)</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Higher five</th><th scope=\"col\">Lower five</th><th scope=\"col\">GCPS</th></tr></thead><tbody><tr><th scope=\"row\">2016</th><td>93.16</td><td>70.96</td><td>79.6</td></tr><tr><th scope=\"row\">2017</th><td>93.80</td><td>74.18</td><td>80.9</td></tr><tr><th scope=\"row\">2018</th><td>93.48</td><td>76.68</td><td>81.7</td></tr><tr><th scope=\"row\">2019</th><td>92.48</td><td>75.96</td><td>80.9</td></tr><tr><th scope=\"row\">2020</th><td>93.48</td><td>78.62</td><td>83.2</td></tr><tr><th scope=\"row\">2021</th><td>92.20</td><td>77.64</td><td>82.5</td></tr><tr><th scope=\"row\">2022</th><td>92.14</td><td>80.68</td><td>83.2</td></tr><tr><th scope=\"row\">2023</th><td>93.44</td><td>78.98</td><td>81.9</td></tr><tr><th scope=\"row\">2024</th><td>93.68</td><td>80.86</td><td>84.1</td></tr><tr><th scope=\"row\">2025</th><td>93.74</td><td>84.50</td><td>85.4</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-4\">GCPS school graduation rates</a>. Group averages calculated by All Things Gwinnett.</div></figure>\n<p>In 2016, the two groups were 22.2 percentage points apart. By 2025, they were 9.2 points apart. Every school in the lower-starting group improved. Shiloh went from 71.6% to 88.7%. Norcross reached 85.4%, exactly the district rate that year. Among the higher starters, North Gwinnett reached 97.4%, while Parkview moved from 92.2% to 88.7%. By 2025, Shiloh and Parkview had arrived at the same rate from very different starting points.<sup class=\"refs\"><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a></sup></p>\n<p>Does that mean the higher-performing schools carried the district? Think about Berkmar. Its 2025 graduation rate was three points below GCPS, yet its own rate had climbed 17.4 points. A school can finish below the district average and still help move that average up. A school already graduating 96% of its cohort has very little room to post a comparable gain.<sup class=\"refs\"><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a></sup></p>\n<p>There’s one more wrinkle. My two groups give each school an equal vote. GCPS counts students. A high school with twice as many students in its adjusted graduation cohort has twice the influence on the district rate. The rates tell us where the gap narrowed. To put a number on how much each school contributed to the overall gain, I’d need the cohort counts in both years. And graduation describes the high school at the end of a feeder pattern. It doesn’t assign a performance rating to the elementary and middle schools that feed it.<sup class=\"refs\"><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a><a href=\"#source-11\" aria-label=\"Source 11\">[11]</a></sup></p>\n<h2 id=\"history\">What was special about Gwinnett schools in the 2000s?</h2>\n<p>There’s a detail in the coverage of Gwinnett’s 2010 Broad Prize that feels especially relevant now. The Associated Press reported that Gwinnett had led Georgia districts serving families with similar incomes in reading and math the year before. It also reported that the middle school math gap between Black and white students had narrowed by eight percentage points from 2006 to 2009. Part of what won Gwinnett recognition was progress among students the overall average could easily hide.<sup class=\"refs\"><a href=\"#source-2\" aria-label=\"Source 2\">[2]</a></sup></p>\n<p>This was a district adding students fast. From fiscal 2004 to 2009, GCPS grew from 129,014 to 157,219 students. That’s 28,205 additional students in five years. The table below shows how uneven that growth was. Enrollment jumped 6.80% in 2006, compared with 1.03% in 2009.<sup class=\"refs\"><a href=\"#source-1\" aria-label=\"Source 1\">[1]</a></sup></p>\n<figure class=\"ex\" id=\"data-enrollment\"><figcaption>How fast did GCPS grow?</figcaption><small>District enrollment, fiscal years 2004–2010</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>How fast did GCPS grow? · District enrollment, fiscal years 2004–2010</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Students</th><th scope=\"col\" data-table-only>YoY growth</th></tr></thead><tbody><tr><th scope=\"row\">2004</th><td data-value=\"129014\">129,014</td><td data-value=\"-Infinity\">Baseline</td></tr><tr><th scope=\"row\">2005</th><td data-value=\"135392\">135,392</td><td data-value=\"4.943649526407986\">+4.94%</td></tr><tr><th scope=\"row\">2006</th><td data-value=\"144598\">144,598</td><td data-value=\"6.799515480973765\">+6.80%</td></tr><tr><th scope=\"row\">2007</th><td data-value=\"152043\">152,043</td><td data-value=\"5.148757244221912\">+5.15%</td></tr><tr><th scope=\"row\">2008</th><td data-value=\"155618\">155,618</td><td data-value=\"2.351308511407957\">+2.35%</td></tr><tr><th scope=\"row\">2009</th><td data-value=\"157219\">157,219</td><td data-value=\"1.0288012954799575\">+1.03%</td></tr><tr><th scope=\"row\">2010</th><td data-value=\"159296\">159,296</td><td data-value=\"1.3210871459556415\">+1.32%</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-1\" aria-label=\"Source 1: Gwinnett County Board of Education, FY2013 financial report, operating statistics, p. 125\">Gwinnett County Board of Education</a></div></figure>\n<p>Those numbers make me cautious about comparing my memory of a building with somebody else’s experience a decade later. The district’s pupil-to-teacher ratio actually fell from 15.10 to 14.19 between 2004 and 2009. That ratio counts full-time-equivalent teaching staff across the system. If the question is whether a particular school had enough room for its students, the same board report lists campus enrollment and building capacity. That’s a better place to look.<sup class=\"refs\"><a href=\"#source-1\" aria-label=\"Source 1\">[1]</a></sup></p>\n<h2 id=\"achievement\">Did the graduation gains show up in reading and math?</h2>\n<p>Here’s where I can’t follow the same ten schools and give you an honest answer. The Education Recovery Scorecard comparison I used measures achievement across grades 3–8 at the district level. It compares Gwinnett with Cobb, DeKalb, Fulton, Columbia and Fayette, selected using size, demographics and socioeconomic characteristics. These aren’t the same comparison groups used in the Broad Prize coverage.<sup class=\"refs\"><a href=\"#source-2\" aria-label=\"Source 2\">[2]</a><a href=\"#source-3\" aria-label=\"Source 3\">[3]</a></sup></p>\n<p>In math, GCPS started 2019 ahead of those peers, at 0.69 grade-level equivalents above the 2019 national benchmark versus 0.38 for the peer average. By 2022, most of Gwinnett’s decline had already occurred. By 2024, Gwinnett stood at 0.09 and its peers at 0.14. Gwinnett remained above Georgia overall even as its earlier lead over similar districts disappeared.<sup class=\"refs\"><a href=\"#source-3\" aria-label=\"Source 3\">[3]</a></sup></p>\n<figure class=\"ex\" id=\"data-math\"><figcaption>Math achievement in grades 3–8</figcaption><small>Grade-level equivalents relative to the 2019 national average</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Math achievement in grades 3–8 · Grade-level equivalents relative to the 2019 national average</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">GCPS</th><th scope=\"col\">Georgia</th><th scope=\"col\">Peer average</th></tr></thead><tbody><tr><th scope=\"row\">2019</th><td>0.69</td><td>−0.18</td><td>0.38</td></tr><tr><th scope=\"row\">2022</th><td>0.12</td><td>−0.62</td><td>0.05</td></tr><tr><th scope=\"row\">2024</th><td>0.09</td><td>−0.67</td><td>0.14</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">Education Recovery Scorecard</a></div></figure>\n<p>Reading followed a different timeline. Gwinnett and its peers started almost even in 2019, at 0.73 and 0.70. In 2022, they were still fairly close. By 2024, Gwinnett had fallen to 0.20 while its peers averaged 0.69. If I were asking educators about the reading results, I’d start with that 2022–2024 period. I’d want to hear which grades and schools saw the change and where students continued making gains.<sup class=\"refs\"><a href=\"#source-3\" aria-label=\"Source 3\">[3]</a></sup></p>\n<figure class=\"ex\" id=\"data-reading\"><figcaption>Reading achievement in grades 3–8</figcaption><small>Grade-level equivalents relative to the 2019 national average</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Reading achievement in grades 3–8 · Grade-level equivalents relative to the 2019 national average</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">GCPS</th><th scope=\"col\">Georgia</th><th scope=\"col\">Peer average</th></tr></thead><tbody><tr><th scope=\"row\">2019</th><td>0.73</td><td>−0.06</td><td>0.70</td></tr><tr><th scope=\"row\">2022</th><td>0.61</td><td>−0.25</td><td>0.68</td></tr><tr><th scope=\"row\">2024</th><td>0.20</td><td>−0.36</td><td>0.69</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">Education Recovery Scorecard</a></div></figure>\n<p>A grade-level equivalent expresses the size of a difference in average achievement. It can’t tell me whether my child is half a year behind. To see whether a handful of clusters drove the district trend, I’d compare the same grade and subject across schools, weight by the number tested, and check which schools fed each cluster that year. Georgia changed from the CRCT to Georgia Milestones in 2014–15, so I wouldn’t draw one continuous line through the old and new proficiency rates.<sup class=\"refs\"><a href=\"#source-3\" aria-label=\"Source 3\">[3]</a><a href=\"#source-8\" aria-label=\"Source 8\">[8]</a><a href=\"#source-11\" aria-label=\"Source 11\">[11]</a></sup></p>\n<h2 id=\"households\">Did higher-income families move farther north in Gwinnett?</h2>\n<p>It’s a fair local question. Maybe the geography of household income changed as Gwinnett grew. But the county’s Census 2000 maps complicate the picture even at the starting line. Parts of Norcross and southwest Gwinnett near DeKalb already had some of the county’s highest poverty rates. The county also identified pockets of poverty in Buford and Lawrenceville. A city name or a compass direction tells you surprisingly little about the households in a particular attendance zone.<sup class=\"refs\"><a href=\"#source-10\" aria-label=\"Source 10\">[10]</a></sup></p>\n<p>Say a northern neighborhood gained higher-income households over ten years. Did families move there from closer to the Perimeter? Did they come from outside Gwinnett? Did households already there earn more? All three could produce a similar-looking map. Comparing inflation-adjusted incomes and child poverty across consistent census boundaries would help establish where the geography changed. Answering who moved from where would require migration data with both ends of the move. The school results here establish neither the movement nor its effect on scores.</p>\n<p>As a dad, I also wonder what has changed inside the household. If rent goes up and a family moves in October, a student may have to learn a new schedule and make friends in the middle of a semester. A parent changing shifts can lose the hour they used to spend reading with their child. A family arriving from abroad may bring another language, years of schooling and a set of school records that takes time to transfer. These are questions I’d want to ask families directly. An enrollment figure doesn’t tell their stories for them.</p>\n<h2 id=\"grad\">Why graduation and SAT scores need different starting lines</h2>\n<p>The first graduation number I found for 2004 was 71.9%. By 2010, it was 84.7%. The 2011 figure was 67.6%. If you stop there, it sounds as though something went terribly wrong overnight. A footnote in the district’s financial report explains that Georgia began using a cohort calculation in 2010–11. Joining those figures with a trend line would make a change in how the state counted look like a change in what happened to kids.<sup class=\"refs\"><a href=\"#source-1\" aria-label=\"Source 1\">[1]</a></sup></p>\n<figure class=\"ex\" id=\"data-historical-graduation\"><figcaption>Graduation under Georgia’s earlier calculation</figcaption><small>District graduation rate (%)</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Graduation under Georgia’s earlier calculation · District graduation rate (%)</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Rate</th></tr></thead><tbody><tr><th scope=\"row\">2004</th><td>71.9</td></tr><tr><th scope=\"row\">2005</th><td>74.8</td></tr><tr><th scope=\"row\">2006</th><td>73.8</td></tr><tr><th scope=\"row\">2007</th><td>77.3</td></tr><tr><th scope=\"row\">2008</th><td>79.1</td></tr><tr><th scope=\"row\">2009</th><td>82.0</td></tr><tr><th scope=\"row\">2010</th><td>84.7</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-1\" aria-label=\"Source 1: Gwinnett County Board of Education, FY2013 financial report, operating statistics, p. 125\">Gwinnett County Board of Education</a></div></figure>\n<p>Under the modern measure, the question is how many students in an adjusted cohort receive a regular diploma within four years. On that measure, GCPS went from 80.9% in 2019 to 88.3% in 2026, close to Georgia’s 88.5%. GCPS reported increases at 22 high schools from 2025 to 2026. The districtwide chart goes a year beyond my ten-school comparison, which uses the district’s published 2016–2025 school table.<sup class=\"refs\"><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a><a href=\"#source-5\" aria-label=\"Source 5\">[5]</a></sup></p>\n<figure class=\"ex\" id=\"data-four-year-graduation\"><figcaption>Four-year graduation under the cohort calculation</figcaption><small>District graduation rate (%)</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Four-year graduation under the cohort calculation · District graduation rate (%)</caption><thead><tr><th scope=\"col\">Class</th><th scope=\"col\">Rate</th></tr></thead><tbody><tr><th scope=\"row\">2016</th><td>79.6</td></tr><tr><th scope=\"row\">2017</th><td>80.9</td></tr><tr><th scope=\"row\">2018</th><td>81.7</td></tr><tr><th scope=\"row\">2019</th><td>80.9</td></tr><tr><th scope=\"row\">2020</th><td>83.2</td></tr><tr><th scope=\"row\">2021</th><td>82.5</td></tr><tr><th scope=\"row\">2022</th><td>83.2</td></tr><tr><th scope=\"row\">2023</th><td>81.9</td></tr><tr><th scope=\"row\">2024</th><td>84.1</td></tr><tr><th scope=\"row\">2025</th><td>85.4</td></tr><tr><th scope=\"row\">2026</th><td>88.3</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-4\" aria-label=\"Source 4: GCPS, graduation rates by school and district, classes of 2016–2025\">Gwinnett County Public Schools</a> · <a href=\"#source-5\" aria-label=\"Source 5: GCPS, Class of 2026 graduation release, October 5, 2026\">Gwinnett County Public Schools</a></div></figure>\n<p>The SAT has a different complication. The Class of 2024 was the first for which GCPS offered the exam free during the school day to all enrolled students. Think of a student who previously needed a Saturday ride, a registration fee and time off work. Offering the test at school changes who has a practical chance to take it. GCPS averaged 1,016 in 2024. In 2025, 12,719 test takers averaged 1,003. The scores alone can’t sort out how much of that difference came from preparation or participation. For a question about what graduates do next, Georgia also tracks college enrollment and work.<sup class=\"refs\"><a href=\"#source-6\" aria-label=\"Source 6\">[6]</a><a href=\"#source-7\" aria-label=\"Source 7\">[7]</a><a href=\"#source-9\" aria-label=\"Source 9\">[9]</a></sup></p>\n<h2 id=\"verdict\">So, were Gwinnett schools better when we were kids?</h2>\n<p>I see a real basis for the old reputation. I also see real accomplishments today that nostalgia can obscure. If your family knew Shiloh or Berkmar a decade ago, it matters that substantially more students in those cohorts now finish high school on time. If you have a child learning to read, it matters that Gwinnett lost ground against similar districts. You shouldn’t have to dismiss one finding to take the other seriously.<sup class=\"refs\"><a href=\"#source-2\" aria-label=\"Source 2\">[2]</a><a href=\"#source-3\" aria-label=\"Source 3\">[3]</a><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a></sup></p>\n<p>I don’t believe we used to have better teachers or administrators. We have great ones today, and I think they’re doing the best they can with what they have. Reading these figures hasn’t changed that view. A principal can decide where to put a reading specialist. They can’t set a family’s rent, choose a parent’s work hours or decide when a child has to move. I’m asking what changed for students, not taking a jab at the people who have led or taught in our schools.</p>\n<p>For the parent asking about their own cluster, I’d bring a narrower question to the next school meeting: “What’s happened to reading in my child’s grade over the past few years, and what are teachers seeing that the scores miss?” That conversation would tell me more about my kid’s school than any countywide verdict I could give you here.</p>\n<section id=\"faq\"><h2>Frequently asked questions</h2><details><summary>Which Gwinnett high schools made the biggest gains as a group?</summary><p>Among neighborhood high schools with graduation results in both 2016 and 2025, the five with the lowest 2016 rates rose from an average of 71.0% to 84.5%. The five highest starters rose from 93.2% to 93.7%.</p><sup class=\"refs\"><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a></sup></details><details><summary>Did the highest-performing schools carry Gwinnett’s graduation rate?</summary><p>The higher-starting schools sustained high graduation rates. The lower-starting group improved faster. Calculating each group’s contribution to the districtwide gain requires its adjusted cohort sizes as well as its graduation rates.</p><sup class=\"refs\"><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a></sup></details><details><summary>Did reading improve in the same Gwinnett clusters?</summary><p>The district-level reading estimates used here cover grades 3–8. They cannot establish which feeder schools drove the decline or whether those schools belong to the same clusters that gained in graduation.</p><sup class=\"refs\"><a href=\"#source-3\" aria-label=\"Source 3\">[3]</a></sup></details><details><summary>Does the data show higher-income families moving north within Gwinnett?</summary><p>The historical census maps show where households lived. Establishing that families moved from southwest Gwinnett to northern Gwinnett also requires evidence of their origins and destinations.</p><sup class=\"refs\"><a href=\"#source-10\" aria-label=\"Source 10\">[10]</a></sup></details><details><summary>Does this include Buford City Schools?</summary><p>The school results cover Gwinnett County Public Schools. Buford City Schools is a separate district. The county census maps cover a broader population than the GCPS student body.</p><sup class=\"refs\"><a href=\"#source-11\" aria-label=\"Source 11\">[11]</a></sup></details></section>\n<h2 id=\"methods\">How I checked the numbers</h2><p>I ranked neighborhood high schools with published four-year graduation rates in both 2016 and 2025 by their 2016 rate. I excluded specialty, alternative and online campuses and schools without a 2016 baseline. Each year’s group figure is the arithmetic mean of the same five published school rates. I calculated changes before rounding. Selecting groups at the extremes of one year can magnify apparent convergence, and high starting rates leave less room for improvement. This is a descriptive comparison rather than an estimate of any school’s effect.<sup class=\"refs\"><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a></sup></p>\n<p>The district series includes the full adjusted cohort. The reading and math figures are the Scorecard’s rounded estimates on a common scale; zero is the 2019 national average. The historical poverty figures describe county residents, a broader group than GCPS students. I did not link individual families, addresses, incomes or test records. You can find the records behind each comparison below.<sup class=\"refs\"><a href=\"#source-3\" aria-label=\"Source 3\">[3]</a><a href=\"#source-4\" aria-label=\"Source 4\">[4]</a><a href=\"#source-10\" aria-label=\"Source 10\">[10]</a></sup></p><section id=\"sources\"><h2>Sources</h2><ol><li id=\"source-1\"><a href=\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\" target=\"_blank\" rel=\"noopener\">Gwinnett County Board of Education, FY2013 financial report, operating statistics, p. 125</a></li><li id=\"source-2\"><a href=\"https://www.gpb.org/news/2010/10/19/gwinnett-schools-win-prestigious-prize\" target=\"_blank\" rel=\"noopener\">Associated Press, October 2010 Broad Prize coverage, via Georgia Public Broadcasting</a></li><li id=\"source-3\"><a href=\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\" target=\"_blank\" rel=\"noopener\">Education Recovery Scorecard, Gwinnett district report, pp. 1–3</a></li><li id=\"source-4\"><a href=\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\" target=\"_blank\" rel=\"noopener\">GCPS, graduation rates by school and district, classes of 2016–2025</a></li><li id=\"source-5\"><a href=\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\" target=\"_blank\" rel=\"noopener\">GCPS, Class of 2026 graduation release, October 5, 2026</a></li><li id=\"source-6\"><a href=\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gwinnett-sat-results-top-national-average\" target=\"_blank\" rel=\"noopener\">GCPS, Class of 2024 SAT results and school-day testing policy</a></li><li id=\"source-7\"><a href=\"https://resources.finalsite.net/images/v1759332983/fultonschoolsorg/oswe4noo5uojmnyqlssb/SATExecutiveSummary2025.pdf\" target=\"_blank\" rel=\"noopener\">Fulton County Schools, 2025 SAT executive summary, Exhibit 4, metro Atlanta comparison</a></li><li id=\"source-8\"><a href=\"https://goews.georgia.gov/dashboards-data-report-card/downloadable-data\" target=\"_blank\" rel=\"noopener\">Georgia education data office, test archives and reporting definitions</a></li><li id=\"source-9\"><a href=\"https://goews.georgia.gov/dashboards-data-report-card/data-dashboards/hs-grad-outcomes\" target=\"_blank\" rel=\"noopener\">Georgia, High School Graduate Outcomes Dashboard</a></li><li id=\"source-10\"><a href=\"https://www.gwinnettcounty.com/static/departments/planning/Census/census_2000_selected_income_and_poverty_status_characteristics.pdf\" target=\"_blank\" rel=\"noopener\">Gwinnett County, Census 2000 income and poverty maps, especially maps 8–9</a></li><li id=\"source-11\"><a href=\"https://www.gcpsk12.org/schools/clusters/list-of-schools-by-cluster\" target=\"_blank\" rel=\"noopener\">GCPS, schools and feeder patterns by cluster</a></li></ol></section></article></main><script>function enableTooltips(f,data,idx,names){\n const plot=f.querySelector('.plot'),svg=plot.querySelector('svg'),dots=[...svg.querySelectorAll('circle')].slice(0,data.length);\n svg.removeAttribute('aria-hidden');svg.setAttribute('role','group');svg.setAttribute('aria-label',f.querySelector('figcaption').textContent);\n svg.querySelectorAll('circle title').forEach(t=>t.remove());\n const tip=document.createElement('div');tip.className='point-tip';tip.hidden=true;plot.append(tip);\n const xs=dots.map(dot=>Number(dot.getAttribute('cx')));\n data.forEach((row,i)=>{\n const left=i?(xs[i-1]+xs[i])/2:48,right=i+1<xs.length?(xs[i]+xs[i+1])/2:600;\n const hit=document.createElementNS(svg.namespaceURI,'rect');\n for(const [k,v] of Object.entries({x:left,y:10,width:right-left,height:177,fill:'transparent',tabindex:0,role:'group'}))hit.setAttribute(k,v);\n const text=idx.map(j=>{const n=row[j];if(f.id==='data-graduation-gap')return names[j]+': '+n.toFixed(2)+'%';if(names[j]==='Rate')return 'Graduation rate: '+n.toFixed(1)+'%';if(names[j]==='Students')return 'Students: '+n.toLocaleString('en-US');return names[j]+': '+n.toFixed(2)+' grade equivalents';});\n const label=[row[0],...text].join('\\n');hit.setAttribute('aria-label',label.replaceAll('\\n',', '));\n function show(){tip.textContent=label;tip.hidden=false;tip.style.left=Math.max(0,Math.min(plot.clientWidth-tip.offsetWidth,(xs[i]/620)*plot.clientWidth-tip.offsetWidth/2))+'px';}\n function hide(){tip.hidden=true}\n hit.addEventListener('pointerenter',show);hit.addEventListener('pointerdown',show);hit.addEventListener('focus',show);hit.addEventListener('blur',hide);hit.addEventListener('keydown',e=>{if(e.key==='Escape')hide()});svg.append(hit);\n });plot.onpointerleave=()=>{tip.hidden=true};\n}\nfor(const f of document.querySelectorAll('.ex')){\n const table=f.querySelector('table'), head=[...table.tHead.rows[0].cells], rows=[...table.tBodies[0].rows], data=rows.map(r=>[...r.cells].map(c=>Number(c.dataset.value ?? c.textContent.replace('−','-')))),names=head.filter(c=>!c.hasAttribute('data-table-only')).map(c=>c.textContent);\n const ctl=f.querySelector('.control'), multi=names.length>2;\n ctl.innerHTML='<label>View <select></select></label>'; const sel=ctl.querySelector('select');\n for(const [i,n] of (multi?['All comparisons',...names.slice(1)]:['All years',...data.map(r=>r[0])]).entries())sel.add(new Option(n,i));\n function draw(){const pick=+sel.value,idx=names.slice(1).map((_,i)=>i+1).filter(i=>!multi||!pick||i===pick), colors=['#17634f','#ad4c26','#325c96'];const groupRates=f.id==='data-graduation-gap',lo=groupRates?0:multi?-1:0,hi=groupRates?100:multi?1:names[1]==='Students'?180000:100;const X=x=>65+(x-data[0][0])/(data.at(-1)[0]-data[0][0])*515,Y=y=>170-(y-lo)/(hi-lo)*140;\n let s='';for(let i=0;i<=4;i++){const v=lo+(hi-lo)*i/4;s+='<path stroke=\"#d9dfda\" d=\"M65 '+Y(v)+'H580\"/><text x=\"55\" y=\"'+(Y(v)+4)+'\" text-anchor=\"end\">'+v.toLocaleString()+'</text>'}\n for(const j of idx){const col=colors[j-1];s+='<polyline fill=\"none\" stroke=\"'+col+'\" stroke-width=\"3\" points=\"'+data.map(r=>X(r[0])+','+Y(r[j])).join(' ')+'\"/>';data.forEach((r,i)=>s+='<circle cx=\"'+X(r[0])+'\" cy=\"'+Y(r[j])+'\" r=\"'+(!multi&&pick===i+1?7:4)+'\" fill=\"'+col+'\"><title>'+r[0]+' · '+names[j]+': '+r[j]+'</title></circle>');}\n data.forEach((r,i)=>{if(data.length<9||i%2===0)s+='<text x=\"'+X(r[0])+'\" y=\"192\" text-anchor=\"middle\">'+r[0]+'</text>'});\n f.querySelector('.plot').innerHTML='<svg aria-hidden=\"true\" viewBox=\"0 0 620 205\" font-family=\"Arial\" font-size=\"14\">'+s+'</svg>'+(multi?idx.map(j=>'<span style=\"font:14px Arial;margin-right:12px;color:'+colors[j-1]+'\">● '+names[j]+'</span>').join(''):'');rows.forEach((r,i)=>r.hidden=!multi&&pick!==0&&pick!==i+1);head.forEach((_,j)=>{const hide=multi&&pick&&j!==0&&j!==pick;head[j].hidden=!!hide;rows.forEach(r=>r.cells[j].hidden=!!hide)});enableTooltips(f,data,idx,names);}\n head.forEach((h,j)=>{const b=document.createElement('button');b.textContent=h.textContent;b.title='Sort by '+b.textContent;h.replaceChildren(b);b.onclick=()=>{const asc=h.getAttribute('aria-sort')!=='ascending';head.forEach(c=>c.removeAttribute('aria-sort'));h.setAttribute('aria-sort',asc?'ascending':'descending');[...rows].sort((x,y)=>(data[rows.indexOf(x)][j]-data[rows.indexOf(y)][j])*(asc?1:-1)).forEach(r=>table.tBodies[0].append(r))}});sel.onchange=draw;draw();}\n</script></body></html>"