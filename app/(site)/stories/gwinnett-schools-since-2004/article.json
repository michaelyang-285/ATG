"<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Were Gwinnett Schools Better in the 2000s? | GCPS Data</title><meta name=\"description\" content=\"Compare Gwinnett County Public Schools from 2004 to 2026. Explore graduation rates, SAT participation, and how GCPS reading and math compare with Georgia.\"><meta property=\"og:type\" content=\"article\"><meta property=\"og:title\" content=\"Were Gwinnett schools better when you were a kid?\"><meta property=\"og:description\" content=\"Gwinnett once led similar Georgia districts in reading and math. We went back to 2004 to see where GCPS lost ground and where more students are succeeding.\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Were Gwinnett County Public Schools better in the 2000s?\",\"description\":\"Gwinnett graduation rates have climbed, but reading and math lost ground. Explore GCPS data from 2004 to 2026 and compare the district with Georgia peers.\",\"author\":{\"@type\":\"Person\",\"name\":\"Michael Yang\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"All Things Gwinnett\"},\"citation\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\",\"https://www.gpb.org/news/2010/10/19/gwinnett-schools-win-prestigious-prize\",\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\",\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\",\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\",\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gwinnett-sat-results-top-national-average\",\"https://resources.finalsite.net/images/v1759332983/fultonschoolsorg/oswe4noo5uojmnyqlssb/SATExecutiveSummary2025.pdf\",\"https://goews.georgia.gov/dashboards-data-report-card/downloadable-data\",\"https://goews.georgia.gov/dashboards-data-report-card/data-dashboards/hs-grad-outcomes\"],\"inLanguage\":\"en-US\",\"@id\":\"#article\",\"hasPart\":[{\"@id\":\"#data-enrollment\"},{\"@id\":\"#data-math\"},{\"@id\":\"#data-reading\"},{\"@id\":\"#data-historical-graduation\"},{\"@id\":\"#data-four-year-graduation\"},{\"@id\":\"#faq\"}]},{\"@type\":\"Dataset\",\"@id\":\"#data-enrollment\",\"name\":\"How fast did GCPS grow?\",\"description\":\"How fast did GCPS grow?. District enrollment, fiscal years 2004–2010. Reported years: 2004, 2005, 2006, 2007, 2008, 2009, 2010.\",\"temporalCoverage\":\"2004/2010\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"District enrollment, fiscal years 2004–2010\",\"citation\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isBasedOn\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-math\",\"name\":\"Math achievement in grades 3–8\",\"description\":\"Math achievement in grades 3–8. Grade-level equivalents relative to the 2019 national average. Reported years: 2019, 2022, 2024.\",\"temporalCoverage\":\"2019/2024\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"Grade-level equivalents relative to the 2019 national average\",\"citation\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isBasedOn\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-reading\",\"name\":\"Reading achievement in grades 3–8\",\"description\":\"Reading achievement in grades 3–8. Grade-level equivalents relative to the 2019 national average. Reported years: 2019, 2022, 2024.\",\"temporalCoverage\":\"2019/2024\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"Grade-level equivalents relative to the 2019 national average\",\"citation\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isBasedOn\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-historical-graduation\",\"name\":\"Graduation under Georgia’s earlier calculation\",\"description\":\"Graduation under Georgia’s earlier calculation. District graduation rate (%). Reported years: 2004, 2005, 2006, 2007, 2008, 2009, 2010.\",\"temporalCoverage\":\"2004/2010\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"District graduation rate (%)\",\"citation\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isBasedOn\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-four-year-graduation\",\"name\":\"Four-year graduation under the cohort calculation\",\"description\":\"Four-year graduation under the cohort calculation. District graduation rate (%). Reported years: 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026.\",\"temporalCoverage\":\"2016/2026\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"District graduation rate (%)\",\"citation\":[\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\",\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\"],\"isBasedOn\":[\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\",\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"FAQPage\",\"@id\":\"#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How does Gwinnett compare with Georgia in reading and math?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"On the Education Recovery Scorecard’s 2024 measures for grades 3–8, GCPS was above Georgia in reading and math. It was below the five-district peer average in both subjects, with a larger difference in reading.\"}},{\"@type\":\"Question\",\"name\":\"Which districts are included in Gwinnett’s peer average?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The researchers used Cobb, DeKalb, Fulton, Columbia and Fayette counties. Their comparison takes district size, demographics and socioeconomic characteristics into account.\"}},{\"@type\":\"Question\",\"name\":\"What was Gwinnett’s graduation rate in 2004 and 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The reported rates were 71.9% in 2004 and 88.3% in 2026. Georgia introduced a different calculation in 2010–11. A comparison using the four-year cohort measure shows an increase from 80.9% in 2019 to 88.3% in 2026.\"}},{\"@type\":\"Question\",\"name\":\"Why does SAT participation matter when comparing scores?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A district average depends on who takes the test. Beginning with the Class of 2024, GCPS offered all enrolled students a free school-day SAT. Comparing scores across that change requires attention to participation.\"}},{\"@type\":\"Question\",\"name\":\"Does this comparison include Buford City Schools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"This analysis covers GCPS. Buford City Schools operates as a separate district and is outside the figures used here.\"}}]}]}</script><style>*{box-sizing:border-box}body{margin:0;background:#faf9f5;color:#202d32;font:19px/1.65 Georgia,serif}header,main{max-width:790px;margin:auto;padding:0 21px}header{padding-top:22px;border-top:7px solid #1d5246}header b,nav,.src,figcaption,small,table,summary,label,button,.meta{font-family:Arial,sans-serif}.brand{color:#245749;letter-spacing:.04em}h1{font-size:clamp(39px,6vw,66px);line-height:1.02;letter-spacing:-.045em;margin:30px 0 15px}h2{margin:2em 0 .4em;font-size:clamp(28px,4vw,38px);line-height:1.13;letter-spacing:-.025em}.meta,small,.src{font-size:14px}.src{line-height:1.55;color:#394d48}.hero{display:block;width:100%;height:auto;border-radius:5px;margin:19px 0}a{color:#215f50;text-underline-offset:3px}nav{border-block:1px solid #abb6ae;padding:14px 0;font-size:15px}figure{margin:24px 0 8px;background:white;border:1px solid #c5cfc8;padding:clamp(10px,3vw,24px);border-radius:8px}figcaption{font-weight:700;line-height:1.3}.control{font:15px Arial;margin:13px 0}.scroll{overflow:auto}table{border-collapse:collapse;width:100%;font-size:14px;font-variant-numeric:tabular-nums}td,th{text-align:right;border-bottom:1px solid #ddd;padding:6px}th:first-child{text-align:left}caption{text-align:left;font-size:12px;margin-top:10px}summary,button,select{cursor:pointer}select,button{font:inherit;color:inherit}button{background:transparent;border:0;text-decoration:underline}summary{font-size:15px}svg{width:100%;height:auto}main{padding-bottom:65px} .refs{margin-left:.2em;font:11px Arial;vertical-align:super}.refs a{padding:2px;text-decoration:none}.refs a:hover,.refs a:focus{text-decoration:underline}.credit,#sources li{font:14px/1.55 Arial,sans-serif}.credit{border-top:1px solid #d9dfda;margin-top:14px;padding-top:9px}#sources li{margin:.6em 0;padding:.25em}#sources li:target{background:#fff0c5} .plot{position:relative}.point-tip{position:absolute;top:0;pointer-events:none;white-space:pre-line;background:#163e35;color:white;padding:6px 10px;border-radius:6px;font:13px/1.45 Arial,sans-serif;box-shadow:0 2px 8px #0003}.plot rect:focus-visible{outline:2px solid #17634f} .contents{margin:30px 0;padding:20px 24px;background:#eff3ed;border:1px solid #c3d1c7;border-radius:10px}.contents strong{font: bold 24px Georgia,serif}.contents ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;padding:0;margin:12px 0 0;list-style:none}.contents a{display:flex;align-items:center;justify-content:space-between;min-height:44px;gap:8px;border-top:1px solid #ccd7ce;text-decoration:none}.contents a:hover,.contents a:focus-visible{text-decoration:underline}.contents span{color:#497361}#faq details{border-bottom:1px solid #c4cfc7;padding:0 0 2px}#faq summary{padding:14px 0;font-weight:600;line-height:1.5}#faq p{margin:0 0 10px}#faq .refs{display:block;margin-bottom:12px}#faq summary:focus-visible,.contents a:focus-visible{outline:2px solid #215f50;outline-offset:2px}@media(max-width:560px){.contents{padding:16px}.contents ul{grid-template-columns:1fr}}</style><link rel=\"canonical\" href=\"https://allthingsgwinnett.com/stories/gwinnett-schools-since-2004\"><meta property=\"og:url\" content=\"https://allthingsgwinnett.com/stories/gwinnett-schools-since-2004\"><meta property=\"og:image\" content=\"https://allthingsgwinnett.com/images/gcps-schools-social.jpg\"><meta property=\"og:image:width\" content=\"1200\"><meta property=\"og:image:height\" content=\"630\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"keywords\" content=\"Gwinnett County Public Schools, GCPS, Gwinnett schools, Gwinnett school rankings, Gwinnett schools in the 2000s, school performance, graduation rate, SAT scores, reading scores, math scores, student achievement, Georgia school districts, Gwinnett school enrollment\"></head><body><header><b class=\"brand\"><a href=\"/\">All Things Gwinnett</a> / <a href=\"/local-life\">Local Life</a></b><h1>Were Gwinnett County Public Schools better in the 2000s?</h1><div class=\"meta\">Education · By Michael Yang, All Things Gwinnett · November 21, 2026</div><img class=\"hero\" width=\"1672\" height=\"941\" src=\"/images/gcps-school-bus.jpg\" alt=\"A yellow school bus rounds a curve outside a brick school building.\"></header><main><article><p>When I ask whether Gwinnett schools were better in the 2000s, I have to ask myself what I mean by “better.” If I mean reading, Gwinnett lost ground against comparable Georgia districts between 2019 and 2024. If I mean getting students across the graduation stage in four years, GCPS did better in 2026 than it did in 2019. As a Gwinnett parent, I care about both.<sup class=\"refs\"><a href=\"#source-2\" aria-label=\"Source 2: Associated Press, October 2010 Broad Prize coverage, via Georgia Public Broadcasting\">[2]</a><a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">[3]</a><a href=\"#source-4\" aria-label=\"Source 4: GCPS, graduation rates by school and district, classes of 2016–2025\">[4]</a><a href=\"#source-5\" aria-label=\"Source 5: GCPS, Class of 2026 graduation release, October 5, 2026\">[5]</a></sup></p><p>I’m Michael Yang. I’m a local parent reading public reports, not a professional education researcher. I wanted to know how much of Gwinnett’s old reputation I could actually see in the numbers. I didn’t come into this thinking we used to have better teachers or administrators. We have great ones today, and I believe they’re doing the best they can with the resources they have.</p><p>I started in 2004 and followed each measure as far as the records allowed. Along the way, one question kept coming up for me: What else was happening in these kids’ lives? The reports can tell me how groups of students performed. They tell me very little about what those students went home to after the bell.</p><nav aria-label=\"In this article\" class=\"contents\"><strong>In this article</strong><ul><li><a href=\"#reputation\">Gwinnett in the 2000s<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#achievement\">Reading and math<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#grad\">Graduation rates<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#sat\">SAT scores<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#households\">Households and school clusters<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#verdict\">What the numbers say<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#faq\">Frequently asked questions<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#methods\">How we checked<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#sources\">Sources<span aria-hidden=\"true\">↓</span></a></li></ul></nav><h2 id=\"reputation\">Why did Gwinnett schools have such a strong reputation in the 2000s?</h2><p>One detail from the coverage of Gwinnett’s 2010 Broad Prize helped me understand why people remember that era so fondly. The Associated Press reported that, the previous year, Gwinnett outperformed other Georgia districts serving families with similar incomes in both reading and math. And from 2006 to 2009, the gap between Black and white students in middle school math narrowed by eight percentage points. That second detail matters to me. A district can get good press for a high average. Back then, there was also evidence that a longstanding gap was getting smaller.<sup class=\"refs\"><a href=\"#source-2\" aria-label=\"Source 2: Associated Press, October 2010 Broad Prize coverage, via Georgia Public Broadcasting\">[2]</a></sup></p><p>Picture a student starting school here in 2004. By 2009, GCPS had added 28,205 students, taking enrollment from 129,014 to 157,219. That’s about 22% growth in five years. Even so, the district reported fewer students per full-time-equivalent teacher in 2009 than in 2004: 14.19 versus 15.10. That surprised me. I would have expected a growing system to look more crowded by that measure.</p><figure class=\"ex\" id=\"data-enrollment\"><figcaption>How fast did GCPS grow?</figcaption><small>District enrollment, fiscal years 2004–2010</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>How fast did GCPS grow? · District enrollment, fiscal years 2004–2010</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Students</th></tr></thead><tbody><tr><th scope=\"row\">2004</th><td>129014</td></tr><tr><th scope=\"row\">2005</th><td>135392</td></tr><tr><th scope=\"row\">2006</th><td>144598</td></tr><tr><th scope=\"row\">2007</th><td>152043</td></tr><tr><th scope=\"row\">2008</th><td>155618</td></tr><tr><th scope=\"row\">2009</th><td>157219</td></tr><tr><th scope=\"row\">2010</th><td>159296</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-1\" aria-label=\"Source 1: Gwinnett County Board of Education, FY2013 financial report, operating statistics, p. 125\">Gwinnett County Board of Education</a></div></figure><p>Of course, nobody sat in a classroom with 14.19 students. The ratio counts teachers across the system. If you remember trailers outside your school or a hallway that felt packed, your memory and the district figures can both be accurate. The old board report lists enrollment and building capacity school by school. That’s where I’d start if the question were about a particular campus.</p><h2 id=\"achievement\">How do Gwinnett reading and math scores compare with Georgia?</h2><p>The clearest recent math comparison I found comes from the Education Recovery Scorecard. In 2019, Gwinnett’s grades 3–8 scored 0.69 grade-level equivalents above the 2019 national average. Five similar Georgia districts averaged 0.38 above it. In 2024, Gwinnett was at 0.09 and the comparison group was at 0.14. Gwinnett’s earlier lead had largely disappeared. The small difference at the end matters less to me than how far the two groups moved from where they started.</p><p>Those five districts are Cobb, DeKalb, Fulton, Columbia and Fayette. The researchers chose them based on size, demographics and socioeconomic characteristics. That gives us a more useful reference point than picking a neighboring county because we recognize its name. It also sets a limit on the history we can write. The 2010 award coverage used an income-based comparison. These two sources can’t tell us the year Gwinnett lost its old lead.</p><figure class=\"ex\" id=\"data-math\"><figcaption>Math achievement in grades 3–8</figcaption><small>Grade-level equivalents relative to the 2019 national average</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Math achievement in grades 3–8 · Grade-level equivalents relative to the 2019 national average</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">GCPS</th><th scope=\"col\">Georgia</th><th scope=\"col\">Peer average</th></tr></thead><tbody><tr><th scope=\"row\">2019</th><td>0.69</td><td>−0.18</td><td>0.38</td></tr><tr><th scope=\"row\">2022</th><td>0.12</td><td>−0.62</td><td>0.05</td></tr><tr><th scope=\"row\">2024</th><td>0.09</td><td>−0.67</td><td>0.14</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">Education Recovery Scorecard</a></div></figure><p>Reading is the chart I’d spend the most time with. In 2019, Gwinnett and its comparison districts were almost side by side, at 0.73 and 0.70. By 2022, they were still close. Two years later, Gwinnett was at 0.20 while the other districts averaged 0.69. Gwinnett still scored above Georgia overall. But the parents asking whether Gwinnett still has the edge it once had are asking a different question, and this comparison gives them a reason to keep asking it.</p><figure class=\"ex\" id=\"data-reading\"><figcaption>Reading achievement in grades 3–8</figcaption><small>Grade-level equivalents relative to the 2019 national average</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Reading achievement in grades 3–8 · Grade-level equivalents relative to the 2019 national average</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">GCPS</th><th scope=\"col\">Georgia</th><th scope=\"col\">Peer average</th></tr></thead><tbody><tr><th scope=\"row\">2019</th><td>0.73</td><td>−0.06</td><td>0.70</td></tr><tr><th scope=\"row\">2022</th><td>0.61</td><td>−0.25</td><td>0.68</td></tr><tr><th scope=\"row\">2024</th><td>0.20</td><td>−0.36</td><td>0.69</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">Education Recovery Scorecard</a></div></figure><p>If you’re reading that chart with your own child in mind, a grade-level equivalent is a way for researchers to express the size of a difference in average scores. It won’t tell you whether your child is reading on grade level. It can’t even tell you whether reading went up or down in your high school cluster. That would take local results for the grades and schools your child actually attends.</p><p>The math results give one example of how much an average can hide. From 2019 to 2024, estimated achievement fell by 0.96 grade equivalents for Hispanic students, 0.42 for Black students, 0.22 for Asian students and 0.13 for white students in GCPS. Those groupings describe students whose scores were counted. They do not tell us which families moved, who was learning English, what support a child received, or why one group’s average changed more than another’s.<sup class=\"refs\"><a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">[3]</a></sup></p><h2 id=\"grad\">Are more Gwinnett students graduating from high school?</h2><p>Graduation gave me a different answer from reading. For the Class of 2019, 80.9% of Gwinnett’s cohort graduated in four years. For the Class of 2026, 88.3% did, close to Georgia’s 88.5%. For every hundred students counted, that works out to about seven more finishing on time. That’s worth recognizing even as we ask harder questions about earlier grades.<sup class=\"refs\"><a href=\"#source-4\" aria-label=\"Source 4: GCPS, graduation rates by school and district, classes of 2016–2025\">[4]</a><a href=\"#source-5\" aria-label=\"Source 5: GCPS, Class of 2026 graduation release, October 5, 2026\">[5]</a></sup></p><p>I nearly read the oldest graduation figures the wrong way. The district reported 71.9% in 2004, 84.7% in 2010 and 67.6% in 2011. Read straight across, it looks like something went terribly wrong in a single year. Then there’s the footnote: Georgia began tracking graduation using a cohort calculation in 2010–11. That’s why you’ll see two charts below. A line connecting 2010 and 2011 would suggest we knew how much graduation changed that year under one consistent measure. We don’t.</p><figure class=\"ex\" id=\"data-historical-graduation\"><figcaption>Graduation under Georgia’s earlier calculation</figcaption><small>District graduation rate (%)</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Graduation under Georgia’s earlier calculation · District graduation rate (%)</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Rate</th></tr></thead><tbody><tr><th scope=\"row\">2004</th><td>71.9</td></tr><tr><th scope=\"row\">2005</th><td>74.8</td></tr><tr><th scope=\"row\">2006</th><td>73.8</td></tr><tr><th scope=\"row\">2007</th><td>77.3</td></tr><tr><th scope=\"row\">2008</th><td>79.1</td></tr><tr><th scope=\"row\">2009</th><td>82.0</td></tr><tr><th scope=\"row\">2010</th><td>84.7</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-1\" aria-label=\"Source 1: Gwinnett County Board of Education, FY2013 financial report, operating statistics, p. 125\">Gwinnett County Board of Education</a></div></figure><figure class=\"ex\" id=\"data-four-year-graduation\"><figcaption>Four-year graduation under the cohort calculation</figcaption><small>District graduation rate (%)</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Four-year graduation under the cohort calculation · District graduation rate (%)</caption><thead><tr><th scope=\"col\">Class</th><th scope=\"col\">Rate</th></tr></thead><tbody><tr><th scope=\"row\">2016</th><td>79.6</td></tr><tr><th scope=\"row\">2017</th><td>80.9</td></tr><tr><th scope=\"row\">2018</th><td>81.7</td></tr><tr><th scope=\"row\">2019</th><td>80.9</td></tr><tr><th scope=\"row\">2020</th><td>83.2</td></tr><tr><th scope=\"row\">2021</th><td>82.5</td></tr><tr><th scope=\"row\">2022</th><td>83.2</td></tr><tr><th scope=\"row\">2023</th><td>81.9</td></tr><tr><th scope=\"row\">2024</th><td>84.1</td></tr><tr><th scope=\"row\">2025</th><td>85.4</td></tr><tr><th scope=\"row\">2026</th><td>88.3</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-4\" aria-label=\"Source 4: GCPS, graduation rates by school and district, classes of 2016–2025\">Gwinnett County Public Schools</a> · <a href=\"#source-5\" aria-label=\"Source 5: GCPS, Class of 2026 graduation release, October 5, 2026\">Gwinnett County Public Schools</a></div></figure><p>GCPS says 22 high schools improved their graduation rates from 2025 to 2026, and 18 finished above 90%. That gives us a glimpse of how outcomes vary across schools. It also helps explain why readers from different parts of Gwinnett might recognize different pieces of this story. The graduates in this chart aren’t the same group as the elementary and middle school students represented in the reading chart.<sup class=\"refs\"><a href=\"#source-5\" aria-label=\"Source 5: GCPS, Class of 2026 graduation release, October 5, 2026\">[5]</a></sup></p><h2 id=\"sat\">Do lower SAT scores mean Gwinnett high schools got worse?</h2><p>Think about what it took for a teenager to sit for a Saturday SAT: register, cover the cost and arrange a ride. Starting with the Class of 2024, GCPS offered the exam free during the school day to all enrolled students. Whether a family could manage that Saturday trip suddenly mattered less. That’s an important change in access, and it changes how I read the scores.</p><p>The district average was 1,016 for the Class of 2024. The next class averaged 1,003 among 12,719 test takers. The 13-point difference is real for the students who tested. These reports don’t tell me how the same students would have scored under the earlier arrangements. I wouldn’t use that difference to draw a conclusion about the people teaching high school math or English.<sup class=\"refs\"><a href=\"#source-6\" aria-label=\"Source 6: GCPS, Class of 2024 SAT results and school-day testing policy\">[6]</a><a href=\"#source-7\" aria-label=\"Source 7: Fulton County Schools, 2025 SAT executive summary, Exhibit 4, metro Atlanta comparison\">[7]</a></sup></p><p>There’s another question I’d rather ask about our seniors. What opportunities did they have after graduation? Georgia’s graduate outcomes dashboard follows college enrollment and employment. A fair comparison would give each graduating class the same time after high school. A student from the Class of 2007 has had years to earn a credential that a 2026 graduate is only beginning to work toward.<sup class=\"refs\"><a href=\"#source-9\" aria-label=\"Source 9: Georgia, High School Graduate Outcomes Dashboard\">[9]</a></sup></p><h2 id=\"households\">What changed outside the classroom?</h2><p>This is the part I think about as a dad. Are kids in Gwinnett dealing with different problems than kids did twenty years ago? A parent’s work schedule can change who’s home to help with homework. A rent increase can mean switching schools halfway through a year. A family moving here from another state or another country might be figuring out a new curriculum, a new language or how to get records from a previous school. Families also bring skills, languages and experience that a score report won’t capture.</p><p>Those examples are questions I’d want to investigate, not explanations I found in the data. To understand what actually changed, I’d want household economic data over time, figures on immigration and moves within the U.S., and a chance to hear from families themselves. Enrollment growth tells me how many more students GCPS served. It doesn’t tell me where those children came from or what happened at home.</p><p>I’d also want to follow students through individual high school clusters and their feeder schools. A countywide reading decline can coexist with improvement in a particular cluster. Even within one cluster, an elementary school and a middle school may be moving in different directions. Doing that work across Gwinnett would turn this article into a book. For now, I’d treat the district figures as a reason to look closer at your cluster before drawing a conclusion about it.</p><p>Schools can choose how to teach reading, where to direct support and how to reach families. A principal can’t set a family’s rent or change a parent’s shift. I don’t think it’s fair to hand teachers or administrators responsibility for everything that happens on either side of the school doors.</p><h2 id=\"verdict\">So, were Gwinnett schools better in the 2000s?</h2><p>My answer depends on which part of school life you’re asking about. The old reputation had evidence behind it. The recent reading decline deserves attention. And a larger share of Gwinnett students are finishing high school on time. None of that gives me grounds to rank generations of teachers, principals or superintendents. This is what I found in the reports, and I think our educators deserve both honest questions and credit for the progress students have made.<sup class=\"refs\"><a href=\"#source-2\" aria-label=\"Source 2: Associated Press, October 2010 Broad Prize coverage, via Georgia Public Broadcasting\">[2]</a><a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">[3]</a><a href=\"#source-5\" aria-label=\"Source 5: GCPS, Class of 2026 graduation release, October 5, 2026\">[5]</a></sup></p><p>There’s also a practical limit on a twenty-year comparison. Georgia replaced the CRCT with Georgia Milestones in 2014–15. A passing score under one system doesn’t carry exactly the same meaning under the other. I can describe what distinguished Gwinnett in the 2000s and where its students stand in later, comparable years. I can’t put a single number on how much better or worse school is for a child here today.<sup class=\"refs\"><a href=\"#source-8\" aria-label=\"Source 8: Georgia education data office, test archives and reporting definitions\">[8]</a></sup></p><section id=\"faq\"><h2>Frequently asked questions</h2><details><summary>How does Gwinnett compare with Georgia in reading and math?</summary><p>On the Education Recovery Scorecard’s 2024 measures for grades 3–8, GCPS was above Georgia in reading and math. It was below the five-district peer average in both subjects, with a larger difference in reading.</p><sup class=\"refs\"><a aria-label=\"Source 3\" href=\"#source-3\">[3]</a></sup></details><details><summary>Which districts are included in Gwinnett’s peer average?</summary><p>The researchers used Cobb, DeKalb, Fulton, Columbia and Fayette counties. Their comparison takes district size, demographics and socioeconomic characteristics into account.</p><sup class=\"refs\"><a aria-label=\"Source 3\" href=\"#source-3\">[3]</a></sup></details><details><summary>What was Gwinnett’s graduation rate in 2004 and 2026?</summary><p>The reported rates were 71.9% in 2004 and 88.3% in 2026. Georgia introduced a different calculation in 2010–11. A comparison using the four-year cohort measure shows an increase from 80.9% in 2019 to 88.3% in 2026.</p><sup class=\"refs\"><a aria-label=\"Source 1\" href=\"#source-1\">[1]</a><a aria-label=\"Source 4\" href=\"#source-4\">[4]</a><a aria-label=\"Source 5\" href=\"#source-5\">[5]</a></sup></details><details><summary>Why does SAT participation matter when comparing scores?</summary><p>A district average depends on who takes the test. Beginning with the Class of 2024, GCPS offered all enrolled students a free school-day SAT. Comparing scores across that change requires attention to participation.</p><sup class=\"refs\"><a aria-label=\"Source 6\" href=\"#source-6\">[6]</a></sup></details><details><summary>Does this comparison include Buford City Schools?</summary><p>This analysis covers GCPS. Buford City Schools operates as a separate district and is outside the figures used here.</p></details></section><h2 id=\"methods\">How I checked the numbers</h2><p>For the 2000s, I used the school board’s historical enrollment, staffing and graduation figures and the Associated Press account published when Gwinnett won the Broad Prize. For recent graduation rates I used GCPS releases citing state results. I kept the district’s historical graduation figures and modern cohort series in separate charts because the board report documents a change in the calculation.</p><p>For achievement, I used the Education Recovery Scorecard’s district report, produced by a research collaboration involving Harvard and Stanford. Its rounded values for 2019, 2022 and 2024 share a scale anchored to the 2019 national average. Its peer average comes directly from the report. Matching districts this way helps put the results in context. It does not hold constant everything that happened in families, classrooms or neighborhoods.</p><p>The reporting windows differ: the achievement comparison ends in 2024, SAT figures in 2025 and graduation in 2026. I did not estimate effects from household income, immigration, domestic migration or school leadership. I also did not calculate results for individual clusters. Those questions need their own evidence.</p><section id=\"sources\"><h2>Sources</h2><ol><li id=\"source-1\"><a href=\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\" target=\"_blank\" rel=\"noopener\">Gwinnett County Board of Education, FY2013 financial report, operating statistics, p. 125</a></li><li id=\"source-2\"><a href=\"https://www.gpb.org/news/2010/10/19/gwinnett-schools-win-prestigious-prize\" target=\"_blank\" rel=\"noopener\">Associated Press, October 2010 Broad Prize coverage, via Georgia Public Broadcasting</a></li><li id=\"source-3\"><a href=\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\" target=\"_blank\" rel=\"noopener\">Education Recovery Scorecard, Gwinnett district report, pp. 1–3</a></li><li id=\"source-4\"><a href=\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\" target=\"_blank\" rel=\"noopener\">GCPS, graduation rates by school and district, classes of 2016–2025</a></li><li id=\"source-5\"><a href=\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\" target=\"_blank\" rel=\"noopener\">GCPS, Class of 2026 graduation release, October 5, 2026</a></li><li id=\"source-6\"><a href=\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gwinnett-sat-results-top-national-average\" target=\"_blank\" rel=\"noopener\">GCPS, Class of 2024 SAT results and school-day testing policy</a></li><li id=\"source-7\"><a href=\"https://resources.finalsite.net/images/v1759332983/fultonschoolsorg/oswe4noo5uojmnyqlssb/SATExecutiveSummary2025.pdf\" target=\"_blank\" rel=\"noopener\">Fulton County Schools, 2025 SAT executive summary, Exhibit 4, metro Atlanta comparison</a></li><li id=\"source-8\"><a href=\"https://goews.georgia.gov/dashboards-data-report-card/downloadable-data\" target=\"_blank\" rel=\"noopener\">Georgia education data office, test archives and reporting definitions</a></li><li id=\"source-9\"><a href=\"https://goews.georgia.gov/dashboards-data-report-card/data-dashboards/hs-grad-outcomes\" target=\"_blank\" rel=\"noopener\">Georgia, High School Graduate Outcomes Dashboard</a></li></ol></section></article></main><script>function enableTooltips(f,data,idx,names){\n const plot=f.querySelector('.plot'),svg=plot.querySelector('svg'),dots=[...svg.querySelectorAll('circle')].slice(0,data.length);\n svg.removeAttribute('aria-hidden');svg.setAttribute('role','group');svg.setAttribute('aria-label',f.querySelector('figcaption').textContent);\n svg.querySelectorAll('circle title').forEach(t=>t.remove());\n const tip=document.createElement('div');tip.className='point-tip';tip.hidden=true;plot.append(tip);\n const xs=dots.map(dot=>Number(dot.getAttribute('cx')));\n data.forEach((row,i)=>{\n const left=i?(xs[i-1]+xs[i])/2:48,right=i+1<xs.length?(xs[i]+xs[i+1])/2:600;\n const hit=document.createElementNS(svg.namespaceURI,'rect');\n for(const [k,v] of Object.entries({x:left,y:10,width:right-left,height:177,fill:'transparent',tabindex:0,role:'group'}))hit.setAttribute(k,v);\n const text=idx.map(j=>{const n=row[j];if(names[j]==='Rate')return 'Graduation rate: '+n.toFixed(1)+'%';if(names[j]==='Students')return 'Students: '+n.toLocaleString('en-US');return names[j]+': '+n.toFixed(2)+' grade equivalents';});\n const label=[row[0],...text].join('\\n');hit.setAttribute('aria-label',label.replaceAll('\\n',', '));\n function show(){tip.textContent=label;tip.hidden=false;tip.style.left=Math.max(0,Math.min(plot.clientWidth-tip.offsetWidth,(xs[i]/620)*plot.clientWidth-tip.offsetWidth/2))+'px';}\n function hide(){tip.hidden=true}\n hit.addEventListener('pointerenter',show);hit.addEventListener('pointerdown',show);hit.addEventListener('focus',show);hit.addEventListener('blur',hide);hit.addEventListener('keydown',e=>{if(e.key==='Escape')hide()});svg.append(hit);\n });plot.onpointerleave=()=>{tip.hidden=true};\n}\nfor(const f of document.querySelectorAll('.ex')){\n const table=f.querySelector('table'), head=[...table.tHead.rows[0].cells], rows=[...table.tBodies[0].rows], data=rows.map(r=>[...r.cells].map(c=>Number(c.textContent.replace('−','-')))),names=head.map(c=>c.textContent);\n const ctl=f.querySelector('.control'), multi=head.length>2;\n ctl.innerHTML='<label>View <select></select></label>'; const sel=ctl.querySelector('select');\n for(const [i,n] of (multi?['All comparisons',...names.slice(1)]:['All years',...data.map(r=>r[0])]).entries())sel.add(new Option(n,i));\n function draw(){const pick=+sel.value,idx=names.slice(1).map((_,i)=>i+1).filter(i=>!multi||!pick||i===pick), colors=['#17634f','#ad4c26','#325c96'];const lo=multi?-1:0,hi=multi?1:names[1]==='Students'?180000:100;const X=x=>65+(x-data[0][0])/(data.at(-1)[0]-data[0][0])*515,Y=y=>170-(y-lo)/(hi-lo)*140;\n let s='';for(let i=0;i<=4;i++){const v=lo+(hi-lo)*i/4;s+='<path stroke=\"#d9dfda\" d=\"M65 '+Y(v)+'H580\"/><text x=\"55\" y=\"'+(Y(v)+4)+'\" text-anchor=\"end\">'+v.toLocaleString()+'</text>'}\n for(const j of idx){const col=colors[j-1];s+='<polyline fill=\"none\" stroke=\"'+col+'\" stroke-width=\"3\" points=\"'+data.map(r=>X(r[0])+','+Y(r[j])).join(' ')+'\"/>';data.forEach((r,i)=>s+='<circle cx=\"'+X(r[0])+'\" cy=\"'+Y(r[j])+'\" r=\"'+(!multi&&pick===i+1?7:4)+'\" fill=\"'+col+'\"><title>'+r[0]+' · '+names[j]+': '+r[j]+'</title></circle>');}\n data.forEach((r,i)=>{if(data.length<9||i%2===0)s+='<text x=\"'+X(r[0])+'\" y=\"192\" text-anchor=\"middle\">'+r[0]+'</text>'});\n f.querySelector('.plot').innerHTML='<svg aria-hidden=\"true\" viewBox=\"0 0 620 205\" font-family=\"Arial\" font-size=\"14\">'+s+'</svg>'+(multi?idx.map(j=>'<span style=\"font:14px Arial;margin-right:12px;color:'+colors[j-1]+'\">● '+names[j]+'</span>').join(''):'');rows.forEach((r,i)=>r.hidden=!multi&&pick!==0&&pick!==i+1);head.forEach((_,j)=>{const hide=multi&&pick&&j!==0&&j!==pick;head[j].hidden=!!hide;rows.forEach(r=>r.cells[j].hidden=!!hide)});enableTooltips(f,data,idx,names);}\n head.forEach((h,j)=>{const b=document.createElement('button');b.textContent=h.textContent;b.title='Sort by '+b.textContent;h.replaceChildren(b);b.onclick=()=>{const asc=h.getAttribute('aria-sort')!=='ascending';head.forEach(c=>c.removeAttribute('aria-sort'));h.setAttribute('aria-sort',asc?'ascending':'descending');[...rows].sort((x,y)=>(data[rows.indexOf(x)][j]-data[rows.indexOf(y)][j])*(asc?1:-1)).forEach(r=>table.tBodies[0].append(r))}});sel.onchange=draw;draw();}\n</script></body></html>"