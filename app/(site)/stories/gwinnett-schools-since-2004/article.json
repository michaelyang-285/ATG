"<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Were Gwinnett Schools Better in the 2000s? | GCPS Data</title><meta name=\"description\" content=\"Compare Gwinnett County Public Schools from 2004 to 2026. Explore graduation rates, SAT participation, and how GCPS reading and math compare with Georgia.\"><meta property=\"og:type\" content=\"article\"><meta property=\"og:title\" content=\"Were Gwinnett schools better when you were a kid?\"><meta property=\"og:description\" content=\"Gwinnett once led similar Georgia districts in reading and math. We went back to 2004 to see where GCPS lost ground and where more students are succeeding.\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Were Gwinnett County Public Schools better in the 2000s?\",\"description\":\"Gwinnett graduation rates have climbed, but reading and math lost ground. Explore GCPS data from 2004 to 2026 and compare the district with Georgia peers.\",\"author\":{\"@type\":\"Organization\",\"name\":\"All Things Gwinnett\",\"url\":\"https://allthingsgwinnett.com/about\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"All Things Gwinnett\"},\"citation\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\",\"https://www.gpb.org/news/2010/10/19/gwinnett-schools-win-prestigious-prize\",\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\",\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\",\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\",\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gwinnett-sat-results-top-national-average\",\"https://resources.finalsite.net/images/v1759332983/fultonschoolsorg/oswe4noo5uojmnyqlssb/SATExecutiveSummary2025.pdf\",\"https://goews.georgia.gov/dashboards-data-report-card/downloadable-data\",\"https://goews.georgia.gov/dashboards-data-report-card/data-dashboards/hs-grad-outcomes\"],\"inLanguage\":\"en-US\",\"@id\":\"#article\",\"hasPart\":[{\"@id\":\"#data-enrollment\"},{\"@id\":\"#data-math\"},{\"@id\":\"#data-reading\"},{\"@id\":\"#data-historical-graduation\"},{\"@id\":\"#data-four-year-graduation\"},{\"@id\":\"#faq\"}]},{\"@type\":\"Dataset\",\"@id\":\"#data-enrollment\",\"name\":\"How fast did GCPS grow?\",\"description\":\"How fast did GCPS grow?. District enrollment, fiscal years 2004–2010. Reported years: 2004, 2005, 2006, 2007, 2008, 2009, 2010.\",\"temporalCoverage\":\"2004/2010\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"District enrollment, fiscal years 2004–2010\",\"citation\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isBasedOn\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-math\",\"name\":\"Math achievement in grades 3–8\",\"description\":\"Math achievement in grades 3–8. Grade-level equivalents relative to the 2019 national average. Reported years: 2019, 2022, 2024.\",\"temporalCoverage\":\"2019/2024\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"Grade-level equivalents relative to the 2019 national average\",\"citation\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isBasedOn\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-reading\",\"name\":\"Reading achievement in grades 3–8\",\"description\":\"Reading achievement in grades 3–8. Grade-level equivalents relative to the 2019 national average. Reported years: 2019, 2022, 2024.\",\"temporalCoverage\":\"2019/2024\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"Grade-level equivalents relative to the 2019 national average\",\"citation\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isBasedOn\":[\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-historical-graduation\",\"name\":\"Graduation under Georgia’s earlier calculation\",\"description\":\"Graduation under Georgia’s earlier calculation. District graduation rate (%). Reported years: 2004, 2005, 2006, 2007, 2008, 2009, 2010.\",\"temporalCoverage\":\"2004/2010\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"District graduation rate (%)\",\"citation\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isBasedOn\":[\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"Dataset\",\"@id\":\"#data-four-year-graduation\",\"name\":\"Four-year graduation under the cohort calculation\",\"description\":\"Four-year graduation under the cohort calculation. District graduation rate (%). Reported years: 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026.\",\"temporalCoverage\":\"2016/2026\",\"spatialCoverage\":\"Gwinnett County Public Schools, Georgia, United States\",\"variableMeasured\":\"District graduation rate (%)\",\"citation\":[\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\",\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\"],\"isBasedOn\":[\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\",\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\"],\"isPartOf\":{\"@id\":\"#article\"}},{\"@type\":\"FAQPage\",\"@id\":\"#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How does Gwinnett compare with Georgia in reading and math?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"In 2024, GCPS students in grades 3–8 scored above the Georgia average in both subjects. They scored below the average of five comparable Georgia districts in both subjects. The difference was larger in reading.\"}},{\"@type\":\"Question\",\"name\":\"Which districts are included in Gwinnett’s peer average?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Education Recovery Scorecard compares Gwinnett with Cobb, DeKalb, Fulton, Columbia and Fayette counties. Researchers selected these districts based on size, demographics and socioeconomic characteristics.\"}},{\"@type\":\"Question\",\"name\":\"What was Gwinnett’s graduation rate in 2004 and 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"GCPS reported 71.9% in 2004 and 88.3% in 2026. Georgia changed how it calculated graduation rates in 2010–11, so subtracting those numbers would give a misleading measure of improvement. Using the same four-year cohort method, GCPS rose from 80.9% in 2019 to 88.3% in 2026.\"}},{\"@type\":\"Question\",\"name\":\"Why does SAT participation matter when comparing scores?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Class of 2024 was the first for which GCPS offered a free SAT during the school day to all enrolled students. Broader access can change who takes the exam, which affects how we interpret the district average.\"}},{\"@type\":\"Question\",\"name\":\"Does this comparison include Buford City Schools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The article covers Gwinnett County Public Schools. Buford City Schools is a separate district, so its students are outside the GCPS figures shown here.\"}}]}]}</script><style>*{box-sizing:border-box}body{margin:0;background:#faf9f5;color:#202d32;font:19px/1.65 Georgia,serif}header,main{max-width:790px;margin:auto;padding:0 21px}header{padding-top:22px;border-top:7px solid #1d5246}header b,nav,.src,figcaption,small,table,summary,label,button,.meta{font-family:Arial,sans-serif}.brand{color:#245749;letter-spacing:.04em}h1{font-size:clamp(39px,6vw,66px);line-height:1.02;letter-spacing:-.045em;margin:30px 0 15px}h2{margin:2em 0 .4em;font-size:clamp(28px,4vw,38px);line-height:1.13;letter-spacing:-.025em}.meta,small,.src{font-size:14px}.src{line-height:1.55;color:#394d48}.hero{display:block;width:100%;height:auto;border-radius:5px;margin:19px 0}a{color:#215f50;text-underline-offset:3px}nav{border-block:1px solid #abb6ae;padding:14px 0;font-size:15px}figure{margin:24px 0 8px;background:white;border:1px solid #c5cfc8;padding:clamp(10px,3vw,24px);border-radius:8px}figcaption{font-weight:700;line-height:1.3}.control{font:15px Arial;margin:13px 0}.scroll{overflow:auto}table{border-collapse:collapse;width:100%;font-size:14px;font-variant-numeric:tabular-nums}td,th{text-align:right;border-bottom:1px solid #ddd;padding:6px}th:first-child{text-align:left}caption{text-align:left;font-size:12px;margin-top:10px}summary,button,select{cursor:pointer}select,button{font:inherit;color:inherit}button{background:transparent;border:0;text-decoration:underline}summary{font-size:15px}svg{width:100%;height:auto}main{padding-bottom:65px} .refs{margin-left:.2em;font:11px Arial;vertical-align:super}.refs a{padding:2px;text-decoration:none}.refs a:hover,.refs a:focus{text-decoration:underline}.credit,#sources li{font:14px/1.55 Arial,sans-serif}.credit{border-top:1px solid #d9dfda;margin-top:14px;padding-top:9px}#sources li{margin:.6em 0;padding:.25em}#sources li:target{background:#fff0c5} .plot{position:relative}.point-tip{position:absolute;top:0;pointer-events:none;white-space:pre-line;background:#163e35;color:white;padding:6px 10px;border-radius:6px;font:13px/1.45 Arial,sans-serif;box-shadow:0 2px 8px #0003}.plot rect:focus-visible{outline:2px solid #17634f} .contents{margin:30px 0;padding:20px 24px;background:#eff3ed;border:1px solid #c3d1c7;border-radius:10px}.contents strong{font: bold 24px Georgia,serif}.contents ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;padding:0;margin:12px 0 0;list-style:none}.contents a{display:flex;align-items:center;justify-content:space-between;min-height:44px;gap:8px;border-top:1px solid #ccd7ce;text-decoration:none}.contents a:hover,.contents a:focus-visible{text-decoration:underline}.contents span{color:#497361}#faq details{border-bottom:1px solid #c4cfc7;padding:0 0 2px}#faq summary{padding:14px 0;font-weight:600;line-height:1.5}#faq p{margin:0 0 10px}#faq .refs{display:block;margin-bottom:12px}#faq summary:focus-visible,.contents a:focus-visible{outline:2px solid #215f50;outline-offset:2px}@media(max-width:560px){.contents{padding:16px}.contents ul{grid-template-columns:1fr}}</style><link rel=\"canonical\" href=\"https://allthingsgwinnett.com/stories/gwinnett-schools-since-2004\"><meta property=\"og:url\" content=\"https://allthingsgwinnett.com/stories/gwinnett-schools-since-2004\"><meta property=\"og:image\" content=\"https://allthingsgwinnett.com/images/gcps-schools-social.jpg\"><meta property=\"og:image:width\" content=\"1200\"><meta property=\"og:image:height\" content=\"630\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"keywords\" content=\"Gwinnett County Public Schools, GCPS, Gwinnett schools, Gwinnett school rankings, Gwinnett schools in the 2000s, school performance, graduation rate, SAT scores, reading scores, math scores, student achievement, Georgia school districts, Gwinnett school enrollment\"></head><body><header><b class=\"brand\"><a href=\"/\">All Things Gwinnett</a> / <a href=\"/local-life\">Local Life</a></b><h1>Were Gwinnett County Public Schools better in the 2000s?</h1><div class=\"meta\">Education · All Things Gwinnett · November 21, 2026</div><img class=\"hero\" width=\"1672\" height=\"941\" src=\"/images/gcps-school-bus.jpg\" alt=\"A yellow school bus rounds a curve outside a brick school building.\"></header><main><article><p><strong>Gwinnett has lost some of the academic advantage it once had.</strong> In the late 2000s, the district stood out in Georgia for reading and math. By 2024, Gwinnett still scored above the state average in both subjects, but its elementary and middle school students had fallen behind a group of comparable Georgia districts. High school completion tells a different story. The share of GCPS students graduating in four years reached 88.3% in 2026, up from 80.9% in 2019.<sup class=\"refs\"><a href=\"#source-2\" aria-label=\"Source 2: Associated Press, October 2010 Broad Prize coverage, via Georgia Public Broadcasting\">[2]</a><a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">[3]</a><a href=\"#source-4\" aria-label=\"Source 4: GCPS, graduation rates by school and district, classes of 2016–2025\">[4]</a><a href=\"#source-5\" aria-label=\"Source 5: GCPS, Class of 2026 graduation release, October 5, 2026\">[5]</a></sup></p><p>If you went to school in Gwinnett and now have a child here, you might be comparing two very particular places: the high school you remember and the elementary school your child walks into every morning. What can the district numbers tell you about those two experiences? Quite a bit about achievement and graduation. Much less about the teacher in front of your child, the classes available at your old school or how the hallways feel between bells.</p><p>To look beyond the pandemic years, we went back to a Gwinnett school board report that preserves figures from 2004, contemporary reporting on the district’s national reputation, and later results for Gwinnett County Public Schools. The distinction matters locally. Our figures cover GCPS as a school system. A separate district such as Buford City Schools is outside this comparison.</p><nav aria-label=\"In this article\" class=\"contents\"><strong>In this article</strong><ul><li><a href=\"#reputation\">Gwinnett in the 2000s<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#achievement\">Reading and math<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#grad\">Graduation rates<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#sat\">SAT scores<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#verdict\">What the numbers say<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#faq\">Frequently asked questions<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#methods\">How we checked<span aria-hidden=\"true\">↓</span></a></li><li><a href=\"#sources\">Sources<span aria-hidden=\"true\">↓</span></a></li></ul></nav><h2 id=\"reputation\">Why did Gwinnett schools have such a strong reputation in the 2000s?</h2><p>There was evidence behind it. When Gwinnett won the Broad Prize for Urban Education in 2010, the Associated Press reported that the district had led Georgia systems serving students with similar family incomes in reading and math the previous year. Another detail is worth remembering. Between 2006 and 2009, the middle school math achievement gap between Black and white students in Gwinnett narrowed by eight percentage points. The recognition was partly about who was sharing in the district’s success.<sup class=\"refs\"><a href=\"#source-2\" aria-label=\"Source 2: Associated Press, October 2010 Broad Prize coverage, via Georgia Public Broadcasting\">[2]</a></sup></p><p>Gwinnett did that while adding enough students to change the character of a school system. In fiscal 2004, GCPS enrolled 129,014 students. Five years later it enrolled 157,219. That is 28,205 additional students, about 22% growth. Yet the districtwide pupil-to-teacher ratio edged down over those years, from 15.10 to 14.19. If your memory is of new families arriving faster than the county could build schools, the enrollment figures capture the scale of that change.</p><figure class=\"ex\" id=\"data-enrollment\"><figcaption>How fast did GCPS grow?</figcaption><small>District enrollment, fiscal years 2004–2010</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>How fast did GCPS grow? · District enrollment, fiscal years 2004–2010</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Students</th></tr></thead><tbody><tr><th scope=\"row\">2004</th><td>129014</td></tr><tr><th scope=\"row\">2005</th><td>135392</td></tr><tr><th scope=\"row\">2006</th><td>144598</td></tr><tr><th scope=\"row\">2007</th><td>152043</td></tr><tr><th scope=\"row\">2008</th><td>155618</td></tr><tr><th scope=\"row\">2009</th><td>157219</td></tr><tr><th scope=\"row\">2010</th><td>159296</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-1\" aria-label=\"Source 1: Gwinnett County Board of Education, FY2013 financial report, operating statistics, p. 125\">Gwinnett County Board of Education</a></div></figure><p>That ratio is useful for understanding staffing. It divides all enrolled students by full-time-equivalent teaching staff. It cannot tell a former student how many desks were in a particular classroom. For that more local question, the same financial report lists individual school enrollment and building capacity. A crowded building and a falling districtwide staffing ratio can occur in the same year.</p><h2 id=\"achievement\">How do Gwinnett reading and math scores compare with Georgia?</h2><p>In 2019, Gwinnett held a clear math lead over the five districts the Education Recovery Scorecard identified as its closest Georgia peers. Gwinnett scored 0.69 grade-level equivalents above the 2019 national average. Its peers averaged 0.38 above it. By 2024, Gwinnett stood at 0.09 and the peer average at 0.14. A lead of about three-tenths of a grade equivalent had become a small deficit.</p><p>The comparison districts are Cobb, DeKalb, Fulton, Columbia and Fayette. The researchers matched districts using size, demographics and socioeconomic characteristics. These are a more demanding comparison for Gwinnett than Georgia as a whole. They also answer a different question from the income-based comparison used in the 2010 award coverage. We can document both snapshots. We cannot identify the year Gwinnett lost its old standing by joining the two rankings.</p><figure class=\"ex\" id=\"data-math\"><figcaption>Math achievement in grades 3–8</figcaption><small>Grade-level equivalents relative to the 2019 national average</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Math achievement in grades 3–8 · Grade-level equivalents relative to the 2019 national average</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">GCPS</th><th scope=\"col\">Georgia</th><th scope=\"col\">Peer average</th></tr></thead><tbody><tr><th scope=\"row\">2019</th><td>0.69</td><td>−0.18</td><td>0.38</td></tr><tr><th scope=\"row\">2022</th><td>0.12</td><td>−0.62</td><td>0.05</td></tr><tr><th scope=\"row\">2024</th><td>0.09</td><td>−0.67</td><td>0.14</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">Education Recovery Scorecard</a></div></figure><p>Reading is where the timing gets interesting. Gwinnett and its peers began almost even in 2019. Both were about seven-tenths of a grade equivalent above the national benchmark. As late as 2022, they were still fairly close. Then Gwinnett reading fell from 0.61 to 0.20, while the peer average stayed around 0.69. If you only look at a chart of math losses, you could easily miss when Gwinnett lost the most ground in reading.</p><figure class=\"ex\" id=\"data-reading\"><figcaption>Reading achievement in grades 3–8</figcaption><small>Grade-level equivalents relative to the 2019 national average</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Reading achievement in grades 3–8 · Grade-level equivalents relative to the 2019 national average</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">GCPS</th><th scope=\"col\">Georgia</th><th scope=\"col\">Peer average</th></tr></thead><tbody><tr><th scope=\"row\">2019</th><td>0.73</td><td>−0.06</td><td>0.70</td></tr><tr><th scope=\"row\">2022</th><td>0.61</td><td>−0.25</td><td>0.68</td></tr><tr><th scope=\"row\">2024</th><td>0.20</td><td>−0.36</td><td>0.69</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">Education Recovery Scorecard</a></div></figure><p>What does half a grade equivalent mean for a parent? It describes the size of a change in average achievement on the researchers’ common scale. It does not tell you that your fifth grader is six months behind, or that any student should repeat a grade. It also matters where you draw the comparison line. In 2024 Gwinnett was above Georgia in both subjects. The district could outperform the state and still have lost ground since 2019.</p><p>The district average also hides differences among students. The Scorecard estimates that between 2019 and 2024, average math achievement fell by 0.96 grade equivalents for Hispanic students in GCPS, 0.42 for Black students, 0.22 for Asian students and 0.13 for white students. Those are changes within each group. They show why the old question about who shares in Gwinnett’s academic gains still matters. They do not establish why the changes differed.<sup class=\"refs\"><a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">[3]</a></sup></p><h2 id=\"grad\">Are more Gwinnett students graduating from high school?</h2><p>Yes, compared with earlier classes measured under the same rules. The Class of 2026 reached an 88.3% four-year graduation rate, within two-tenths of a percentage point of Georgia’s 88.5%. In 2019, Gwinnett’s rate was 80.9%. Put another way, for every 100 students in a comparable entering cohort, about seven more finished within four years in 2026 than in 2019.<sup class=\"refs\"><a href=\"#source-4\" aria-label=\"Source 4: GCPS, graduation rates by school and district, classes of 2016–2025\">[4]</a><a href=\"#source-5\" aria-label=\"Source 5: GCPS, Class of 2026 graduation release, October 5, 2026\">[5]</a></sup></p><p>Going back to 2004 turns up a trap. The district recorded a 71.9% graduation rate that year and 84.7% in 2010. The next figure in its historical table is 67.6% in 2011. Did graduation really collapse in a single year? A footnote explains why that conclusion would be misleading. Starting in 2010–11, Georgia used a cohort calculation, tracking an entering group of students toward graduation. The apparent cliff straddles a change in how the state counted.</p><figure class=\"ex\" id=\"data-historical-graduation\"><figcaption>Graduation under Georgia’s earlier calculation</figcaption><small>District graduation rate (%)</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Graduation under Georgia’s earlier calculation · District graduation rate (%)</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Rate</th></tr></thead><tbody><tr><th scope=\"row\">2004</th><td>71.9</td></tr><tr><th scope=\"row\">2005</th><td>74.8</td></tr><tr><th scope=\"row\">2006</th><td>73.8</td></tr><tr><th scope=\"row\">2007</th><td>77.3</td></tr><tr><th scope=\"row\">2008</th><td>79.1</td></tr><tr><th scope=\"row\">2009</th><td>82.0</td></tr><tr><th scope=\"row\">2010</th><td>84.7</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-1\" aria-label=\"Source 1: Gwinnett County Board of Education, FY2013 financial report, operating statistics, p. 125\">Gwinnett County Board of Education</a></div></figure><figure class=\"ex\" id=\"data-four-year-graduation\"><figcaption>Four-year graduation under the cohort calculation</figcaption><small>District graduation rate (%)</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Four-year graduation under the cohort calculation · District graduation rate (%)</caption><thead><tr><th scope=\"col\">Class</th><th scope=\"col\">Rate</th></tr></thead><tbody><tr><th scope=\"row\">2016</th><td>79.6</td></tr><tr><th scope=\"row\">2017</th><td>80.9</td></tr><tr><th scope=\"row\">2018</th><td>81.7</td></tr><tr><th scope=\"row\">2019</th><td>80.9</td></tr><tr><th scope=\"row\">2020</th><td>83.2</td></tr><tr><th scope=\"row\">2021</th><td>82.5</td></tr><tr><th scope=\"row\">2022</th><td>83.2</td></tr><tr><th scope=\"row\">2023</th><td>81.9</td></tr><tr><th scope=\"row\">2024</th><td>84.1</td></tr><tr><th scope=\"row\">2025</th><td>85.4</td></tr><tr><th scope=\"row\">2026</th><td>88.3</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-4\" aria-label=\"Source 4: GCPS, graduation rates by school and district, classes of 2016–2025\">Gwinnett County Public Schools</a> · <a href=\"#source-5\" aria-label=\"Source 5: GCPS, Class of 2026 graduation release, October 5, 2026\">Gwinnett County Public Schools</a></div></figure><p>The recent increase was spread across many high schools. GCPS reported that 22 schools improved their graduation rates from 2025 to 2026, and 18 schools finished above 90%. Those figures describe completion. The reading and math charts measure younger students, in different years, on particular assessments. Seeing graduation rise while those scores fall is a reason to ask how students are doing at different stages of school. It is insufficient evidence for a claim that diplomas have become easier to earn.<sup class=\"refs\"><a href=\"#source-5\" aria-label=\"Source 5: GCPS, Class of 2026 graduation release, October 5, 2026\">[5]</a></sup></p><h2 id=\"sat\">Do lower SAT scores mean Gwinnett high schools got worse?</h2><p>The SAT has a particular complication in Gwinnett. The Class of 2024 was the first for which the district offered the test free during the school day to all enrolled students. Think about the difference for a junior who would otherwise have to register, pay and get to a testing site on a Saturday. Once the exam is available at school, the group taking it can include students who would previously have skipped it.</p><p>GCPS reported an average of 1,016 for the Class of 2024. In 2025, 12,719 Gwinnett students took the SAT and averaged 1,003. That 13-point difference is a change in the average among test takers. To say how much came from preparation and how much from the mix of students taking the exam would require more information. Even a table of neighboring districts’ scores is hard to interpret if one system tests nearly everyone and another mostly tests college applicants.<sup class=\"refs\"><a href=\"#source-6\" aria-label=\"Source 6: GCPS, Class of 2024 SAT results and school-day testing policy\">[6]</a><a href=\"#source-7\" aria-label=\"Source 7: Fulton County Schools, 2025 SAT executive summary, Exhibit 4, metro Atlanta comparison\">[7]</a></sup></p><p>For a family wondering what a Gwinnett diploma leads to, a closer measure is what graduates do next. Georgia’s High School Graduate Outcomes Dashboard tracks college enrollment and work. Comparing graduating classes at the same point after high school would answer a question the SAT cannot: how often did graduates actually make the transition to college or employment? An older class has had longer to earn a degree, so the follow-up window matters as much as the graduation year.<sup class=\"refs\"><a href=\"#source-9\" aria-label=\"Source 9: Georgia, High School Graduate Outcomes Dashboard\">[9]</a></sup></p><h2 id=\"verdict\">So, were Gwinnett schools better in the 2000s?</h2><p>If what you remember is a district recognized for outperforming comparable Georgia systems, that memory has a basis. And if your concern is reading, the recent comparison gives it weight: Gwinnett was roughly level with its peers in 2019 and well behind their average by 2024. For a parent asking whether a ninth grader is more likely to finish high school on time, the direction is more encouraging. Gwinnett has had three consecutive increases in four-year graduation through 2026.<sup class=\"refs\"><a href=\"#source-2\" aria-label=\"Source 2: Associated Press, October 2010 Broad Prize coverage, via Georgia Public Broadcasting\">[2]</a><a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">[3]</a><a href=\"#source-5\" aria-label=\"Source 5: GCPS, Class of 2026 graduation release, October 5, 2026\">[5]</a></sup></p><p>The part we cannot pin down is the exact distance between a Gwinnett classroom in 2004 and one today. Georgia replaced its old CRCT assessments with Georgia Milestones beginning in 2014–15. A student who met the old standard and one who meets the newer standard cleared different bars. That is why the early evidence here describes where Gwinnett stood among comparable districts, while the recent charts measure change on a common scale. For anyone choosing a school now, the district’s history is a starting point. The grade, subject and school your child will actually attend are the next questions.<sup class=\"refs\"><a href=\"#source-8\" aria-label=\"Source 8: Georgia education data office, test archives and reporting definitions\">[8]</a></sup></p><section id=\"faq\"><h2>Frequently asked questions</h2><details><summary>How does Gwinnett compare with Georgia in reading and math?</summary><p>In 2024, GCPS students in grades 3–8 scored above the Georgia average in both subjects. They scored below the average of five comparable Georgia districts in both subjects. The difference was larger in reading.</p><sup class=\"refs\"><a aria-label=\"Source 3\" href=\"#source-3\">[3]</a></sup></details><details><summary>Which districts are included in Gwinnett’s peer average?</summary><p>The Education Recovery Scorecard compares Gwinnett with Cobb, DeKalb, Fulton, Columbia and Fayette counties. Researchers selected these districts based on size, demographics and socioeconomic characteristics.</p><sup class=\"refs\"><a aria-label=\"Source 3\" href=\"#source-3\">[3]</a></sup></details><details><summary>What was Gwinnett’s graduation rate in 2004 and 2026?</summary><p>GCPS reported 71.9% in 2004 and 88.3% in 2026. Georgia changed how it calculated graduation rates in 2010–11, so subtracting those numbers would give a misleading measure of improvement. Using the same four-year cohort method, GCPS rose from 80.9% in 2019 to 88.3% in 2026.</p><sup class=\"refs\"><a aria-label=\"Source 1\" href=\"#source-1\">[1]</a><a aria-label=\"Source 4\" href=\"#source-4\">[4]</a><a aria-label=\"Source 5\" href=\"#source-5\">[5]</a></sup></details><details><summary>Why does SAT participation matter when comparing scores?</summary><p>The Class of 2024 was the first for which GCPS offered a free SAT during the school day to all enrolled students. Broader access can change who takes the exam, which affects how we interpret the district average.</p><sup class=\"refs\"><a aria-label=\"Source 6\" href=\"#source-6\">[6]</a></sup></details><details><summary>Does this comparison include Buford City Schools?</summary><p>No. The article covers Gwinnett County Public Schools. Buford City Schools is a separate district, so its students are outside the GCPS figures shown here.</p></details></section><h2 id=\"methods\">How we checked the numbers</h2><p>All Things Gwinnett compared district records, state documentation, independent research and reporting published when Gwinnett won the Broad Prize. The school board’s historical report supplies the enrollment and early graduation figures. Its footnote identifies the graduation formula change. The modern graduation series comes from GCPS releases reporting Georgia Department of Education results. We show two graduation charts so that changing the formula cannot create a false year-to-year trend.</p><p>The Education Recovery Scorecard, a collaboration involving Harvard and Stanford researchers, supplies the grades 3–8 estimates. The charts reproduce its published, rounded values for three benchmark years. Zero means the 2019 national average; negative values fall below that benchmark. The five-district peer average is the researchers’ published comparison. These estimates describe groups of students and do not isolate the effect of district leadership, instruction, attendance or any single policy.</p><p>The latest year differs by measure: achievement comparisons through 2024, SAT figures through 2025 and graduation through 2026. Historical reputation is attributed to contemporary reporting. The article draws conclusions about the district; school-level experiences can vary.</p><section id=\"sources\"><h2>Sources</h2><ol><li id=\"source-1\"><a href=\"https://ted.cviog.uga.edu/financial-documents/sites/default/files/budgetdoc/financial-report/school-district-gwinnett-county-school-district-gwinnett-county-fy2013-financial-report.pdf\" target=\"_blank\" rel=\"noopener\">Gwinnett County Board of Education, FY2013 financial report, operating statistics, p. 125</a></li><li id=\"source-2\"><a href=\"https://www.gpb.org/news/2010/10/19/gwinnett-schools-win-prestigious-prize\" target=\"_blank\" rel=\"noopener\">Associated Press, October 2010 Broad Prize coverage, via Georgia Public Broadcasting</a></li><li id=\"source-3\"><a href=\"https://educationrecoveryscorecard.org/wp-content/uploads/2025/02/report_GA_1302550_gwinnett-county.pdf\" target=\"_blank\" rel=\"noopener\">Education Recovery Scorecard, Gwinnett district report, pp. 1–3</a></li><li id=\"source-4\"><a href=\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gcps-graduation-rate-reaches-highest-point-in-a-decade-for-second-year-in-a-row\" target=\"_blank\" rel=\"noopener\">GCPS, graduation rates by school and district, classes of 2016–2025</a></li><li id=\"source-5\"><a href=\"https://www.gcpsk12.org/get-connected/district-news-and-communication/all-news/gcps-full-news-article/~board/news-releases/post/graduation-rates-are-on-the-rise-across-gcps\" target=\"_blank\" rel=\"noopener\">GCPS, Class of 2026 graduation release, October 5, 2026</a></li><li id=\"source-6\"><a href=\"https://www.gcpsk12.org/news-details/~board/news-releases/post/gwinnett-sat-results-top-national-average\" target=\"_blank\" rel=\"noopener\">GCPS, Class of 2024 SAT results and school-day testing policy</a></li><li id=\"source-7\"><a href=\"https://resources.finalsite.net/images/v1759332983/fultonschoolsorg/oswe4noo5uojmnyqlssb/SATExecutiveSummary2025.pdf\" target=\"_blank\" rel=\"noopener\">Fulton County Schools, 2025 SAT executive summary, Exhibit 4, metro Atlanta comparison</a></li><li id=\"source-8\"><a href=\"https://goews.georgia.gov/dashboards-data-report-card/downloadable-data\" target=\"_blank\" rel=\"noopener\">Georgia education data office, test archives and reporting definitions</a></li><li id=\"source-9\"><a href=\"https://goews.georgia.gov/dashboards-data-report-card/data-dashboards/hs-grad-outcomes\" target=\"_blank\" rel=\"noopener\">Georgia, High School Graduate Outcomes Dashboard</a></li></ol></section></article></main><script>function enableTooltips(f,data,idx,names){\n const plot=f.querySelector('.plot'),svg=plot.querySelector('svg'),dots=[...svg.querySelectorAll('circle')].slice(0,data.length);\n svg.removeAttribute('aria-hidden');svg.setAttribute('role','group');svg.setAttribute('aria-label',f.querySelector('figcaption').textContent);\n svg.querySelectorAll('circle title').forEach(t=>t.remove());\n const tip=document.createElement('div');tip.className='point-tip';tip.hidden=true;plot.append(tip);\n const xs=dots.map(dot=>Number(dot.getAttribute('cx')));\n data.forEach((row,i)=>{\n const left=i?(xs[i-1]+xs[i])/2:48,right=i+1<xs.length?(xs[i]+xs[i+1])/2:600;\n const hit=document.createElementNS(svg.namespaceURI,'rect');\n for(const [k,v] of Object.entries({x:left,y:10,width:right-left,height:177,fill:'transparent',tabindex:0,role:'group'}))hit.setAttribute(k,v);\n const text=idx.map(j=>{const n=row[j];if(names[j]==='Rate')return 'Graduation rate: '+n.toFixed(1)+'%';if(names[j]==='Students')return 'Students: '+n.toLocaleString('en-US');return names[j]+': '+n.toFixed(2)+' grade equivalents';});\n const label=[row[0],...text].join('\\n');hit.setAttribute('aria-label',label.replaceAll('\\n',', '));\n function show(){tip.textContent=label;tip.hidden=false;tip.style.left=Math.max(0,Math.min(plot.clientWidth-tip.offsetWidth,(xs[i]/620)*plot.clientWidth-tip.offsetWidth/2))+'px';}\n function hide(){tip.hidden=true}\n hit.addEventListener('pointerenter',show);hit.addEventListener('pointerdown',show);hit.addEventListener('focus',show);hit.addEventListener('blur',hide);hit.addEventListener('keydown',e=>{if(e.key==='Escape')hide()});svg.append(hit);\n });plot.onpointerleave=()=>{tip.hidden=true};\n}\nfor(const f of document.querySelectorAll('.ex')){\n const table=f.querySelector('table'), head=[...table.tHead.rows[0].cells], rows=[...table.tBodies[0].rows], data=rows.map(r=>[...r.cells].map(c=>Number(c.textContent.replace('−','-')))),names=head.map(c=>c.textContent);\n const ctl=f.querySelector('.control'), multi=head.length>2;\n ctl.innerHTML='<label>View <select></select></label>'; const sel=ctl.querySelector('select');\n for(const [i,n] of (multi?['All comparisons',...names.slice(1)]:['All years',...data.map(r=>r[0])]).entries())sel.add(new Option(n,i));\n function draw(){const pick=+sel.value,idx=names.slice(1).map((_,i)=>i+1).filter(i=>!multi||!pick||i===pick), colors=['#17634f','#ad4c26','#325c96'];const lo=multi?-1:0,hi=multi?1:names[1]==='Students'?180000:100;const X=x=>65+(x-data[0][0])/(data.at(-1)[0]-data[0][0])*515,Y=y=>170-(y-lo)/(hi-lo)*140;\n let s='';for(let i=0;i<=4;i++){const v=lo+(hi-lo)*i/4;s+='<path stroke=\"#d9dfda\" d=\"M65 '+Y(v)+'H580\"/><text x=\"55\" y=\"'+(Y(v)+4)+'\" text-anchor=\"end\">'+v.toLocaleString()+'</text>'}\n for(const j of idx){const col=colors[j-1];s+='<polyline fill=\"none\" stroke=\"'+col+'\" stroke-width=\"3\" points=\"'+data.map(r=>X(r[0])+','+Y(r[j])).join(' ')+'\"/>';data.forEach((r,i)=>s+='<circle cx=\"'+X(r[0])+'\" cy=\"'+Y(r[j])+'\" r=\"'+(!multi&&pick===i+1?7:4)+'\" fill=\"'+col+'\"><title>'+r[0]+' · '+names[j]+': '+r[j]+'</title></circle>');}\n data.forEach((r,i)=>{if(data.length<9||i%2===0)s+='<text x=\"'+X(r[0])+'\" y=\"192\" text-anchor=\"middle\">'+r[0]+'</text>'});\n f.querySelector('.plot').innerHTML='<svg aria-hidden=\"true\" viewBox=\"0 0 620 205\" font-family=\"Arial\" font-size=\"14\">'+s+'</svg>'+(multi?idx.map(j=>'<span style=\"font:14px Arial;margin-right:12px;color:'+colors[j-1]+'\">● '+names[j]+'</span>').join(''):'');rows.forEach((r,i)=>r.hidden=!multi&&pick!==0&&pick!==i+1);head.forEach((_,j)=>{const hide=multi&&pick&&j!==0&&j!==pick;head[j].hidden=!!hide;rows.forEach(r=>r.cells[j].hidden=!!hide)});enableTooltips(f,data,idx,names);}\n head.forEach((h,j)=>{const b=document.createElement('button');b.textContent=h.textContent;b.title='Sort by '+b.textContent;h.replaceChildren(b);b.onclick=()=>{const asc=h.getAttribute('aria-sort')!=='ascending';head.forEach(c=>c.removeAttribute('aria-sort'));h.setAttribute('aria-sort',asc?'ascending':'descending');[...rows].sort((x,y)=>(data[rows.indexOf(x)][j]-data[rows.indexOf(y)][j])*(asc?1:-1)).forEach(r=>table.tBodies[0].append(r))}});sel.onchange=draw;draw();}\n</script></body></html>"