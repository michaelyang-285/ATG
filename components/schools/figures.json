    "markup": "<small>District graduation rate (%)</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Graduation under Georgia’s earlier calculation · District graduation rate (%)</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Rate</th></tr></thead><tbody><tr><th scope=\"row\">2004</th><td>71.9</td></tr><tr><th scope=\"row\">2005</th><td>74.8</td></tr><tr><th scope=\"row\">2006</th><td>73.8</td></tr><tr><th scope=\"row\">2007</th><td>77.3</td></tr><tr><th scope=\"row\">2008</th><td>79.1</td></tr><tr><th scope=\"row\">2009</th><td>82.0</td></tr><tr><th scope=\"row\">2010</th><td>84.7</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-1\" aria-label=\"Source 1: Gwinnett County Board of Education, FY2013 financial report, operating statistics, p. 125\">Gwinnett County Board of Education</a></div>"
