  "gcps15": {
    "figure": "data-math",
    "markup": "<small>Grade-level equivalents relative to the 2019 national average</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Math achievement in grades 3–8 · Grade-level equivalents relative to the 2019 national average</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">GCPS</th><th scope=\"col\">Georgia</th><th scope=\"col\">Peer average</th></tr></thead><tbody><tr><th scope=\"row\">2019</th><td>0.69</td><td>−0.18</td><td>0.38</td></tr><tr><th scope=\"row\">2022</th><td>0.12</td><td>−0.62</td><td>0.05</td></tr><tr><th scope=\"row\">2024</th><td>0.09</td><td>−0.67</td><td>0.14</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">Education Recovery Scorecard</a></div>"
  },
  "gcps17": {
    "figure": "data-reading",
    "markup": "<small>Grade-level equivalents relative to the 2019 national average</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>Reading achievement in grades 3–8 · Grade-level equivalents relative to the 2019 national average</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">GCPS</th><th scope=\"col\">Georgia</th><th scope=\"col\">Peer average</th></tr></thead><tbody><tr><th scope=\"row\">2019</th><td>0.73</td><td>−0.06</td><td>0.70</td></tr><tr><th scope=\"row\">2022</th><td>0.61</td><td>−0.25</td><td>0.68</td></tr><tr><th scope=\"row\">2024</th><td>0.20</td><td>−0.36</td><td>0.69</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-3\" aria-label=\"Source 3: Education Recovery Scorecard, Gwinnett district report, pp. 1–3\">Education Recovery Scorecard</a></div>"
