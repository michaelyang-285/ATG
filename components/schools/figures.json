  "gcps11": {
    "figure": "data-enrollment",
    "markup": "<small>District enrollment, fiscal years 2004–2010</small><div class=\"control\"></div><div class=\"plot\"></div><details open=\"\"><summary>Explore the data table</summary><div class=\"scroll\"><table><caption>How fast did GCPS grow? · District enrollment, fiscal years 2004–2010</caption><thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Students</th><th scope=\"col\" data-table-only=\"\">YoY growth</th></tr></thead><tbody><tr><th scope=\"row\">2004</th><td data-value=\"129014\">129,014</td><td data-value=\"-Infinity\">Baseline</td></tr><tr><th scope=\"row\">2005</th><td data-value=\"135392\">135,392</td><td data-value=\"4.943649526407986\">+4.94%</td></tr><tr><th scope=\"row\">2006</th><td data-value=\"144598\">144,598</td><td data-value=\"6.799515480973765\">+6.80%</td></tr><tr><th scope=\"row\">2007</th><td data-value=\"152043\">152,043</td><td data-value=\"5.148757244221912\">+5.15%</td></tr><tr><th scope=\"row\">2008</th><td data-value=\"155618\">155,618</td><td data-value=\"2.351308511407957\">+2.35%</td></tr><tr><th scope=\"row\">2009</th><td data-value=\"157219\">157,219</td><td data-value=\"1.0288012954799575\">+1.03%</td></tr><tr><th scope=\"row\">2010</th><td data-value=\"159296\">159,296</td><td data-value=\"1.3210871459556415\">+1.32%</td></tr></tbody></table></div></details><div class=\"credit\">Source: <a href=\"#source-1\" aria-label=\"Source 1: Gwinnett County Board of Education, FY2013 financial report, operating statistics, p. 125\">Gwinnett County Board of Education</a></div>"
  },
